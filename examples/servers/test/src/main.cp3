import { createServer } from "std/network";
import console from "std/console";
import os from "std/os";

console.clear();
 
const app = createServer({ threads: os.cpus() });

app.get("/healthz", (req, res) => {
  res.text("ok");
});

app.get("/",async (req, res) => {
  const input =await console.input("Request received, What would you like to do? : ");
  res.json({ service: String(input), status: "ok" });
  console.log(`\nResponse sent for request: ${req.method} ${req.path}`);
});

app.use((req, res, next) => {
  console.log(`404: ${req.method} ${req.path}`);
  res.status(404).text("not found");
});

app.listen(3000, () => {
  console.log("listening on http://localhost:3000");
});
