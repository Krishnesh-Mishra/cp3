{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cp3",
  "scopeName": "source.cp3",
  "fileTypes": [
    "cp3"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#inheritance"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#members"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.cp3",
          "begin": "/\\*\\*",
          "beginCaptures": {
            "0": {"name": "punctuation.definition.comment.begin.cp3"}
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {"name": "punctuation.definition.comment.end.cp3"}
          },
          "patterns": [
            {
              "match": "(@param)(\\s+)(\\{[^}]+\\})(\\s+)([A-Za-z_$][A-Za-z0-9_$]*)",
              "captures": {
                "1": {"name": "storage.type.class.jsdoc.cp3"},
                "3": {"name": "entity.name.type.jsdoc.cp3"},
                "5": {"name": "variable.parameter.jsdoc.cp3"}
              }
            },
            {
              "match": "(@param)(\\s+)([A-Za-z_$][A-Za-z0-9_$]*)",
              "captures": {
                "1": {"name": "storage.type.class.jsdoc.cp3"},
                "3": {"name": "variable.parameter.jsdoc.cp3"}
              }
            },
            {
              "name": "storage.type.class.jsdoc.cp3",
              "match": "@(param|arg|argument|returns?|throws?|deprecated|example|see|type|template|module|since|author|remarks|deprecated)\\b"
            },
            {
              "name": "entity.name.type.jsdoc.cp3",
              "match": "\\{[A-Za-z_$][A-Za-z0-9_$.,<> |\\[\\]?]*\\}"
            }
          ]
        },
        {
          "name": "comment.block.cp3",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.cp3"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.cp3"
            }
          }
        },
        {
          "name": "comment.line.double-slash.cp3",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.cp3"
            }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#template-literal"
        },
        {
          "include": "#string-single"
        },
        {
          "include": "#string-double"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.cp3",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.cp3"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.cp3"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.cp3",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.cp3"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.cp3"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "template-literal": {
      "name": "string.template.cp3",
      "begin": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.begin.cp3"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.cp3"
        }
      },
      "patterns": [
        {
          "include": "#template-expression"
        },
        {
          "include": "#string-escapes"
        }
      ]
    },
    "template-expression": {
      "name": "meta.template.expression.cp3",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.cp3"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.cp3"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.cp3",
          "match": "\\\\[\\\\`'\"bfnrtv0]|\\\\x[0-9A-Fa-f]{2}|\\\\u[0-9A-Fa-f]{4}|\\\\u\\{[0-9A-Fa-f]+\\}"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cp3",
          "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.binary.cp3",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.octal.cp3",
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.decimal.cp3",
          "match": "(?<![\\w$.])\\d(?:_?\\d)*(?:\\.(?:_?\\d)*)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.cp3",
          "match": "(?<![\\w$.])\\.\\d(?:_?\\d)*(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "include": "#function-declaration"
        },
        {
          "include": "#class-declaration"
        },
        {
          "include": "#interface-declaration"
        },
        {
          "include": "#enum-declaration"
        },
        {
          "include": "#type-alias-declaration"
        },
        {
          "include": "#variable-declaration"
        },
        {
          "include": "#accessor-declaration"
        },
        {
          "include": "#constructor-declaration"
        }
      ]
    },
    "inheritance": {
      "name": "meta.inherits.cp3",
      "match": "\\b(extends|implements)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.extends.cp3"
        },
        "2": {
          "name": "entity.other.inherited-class.cp3"
        }
      }
    },
    "function-declaration": {
      "name": "meta.function.cp3",
      "begin": "\\b(function)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.cp3"
        },
        "2": {
          "name": "entity.name.function.cp3"
        }
      },
      "end": "(?=[{;])|(?<=\\))(?![ \\t]*:)|(?=\\})",
      "patterns": [
        {
          "include": "#parameter-list"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#code"
        }
      ]
    },
    "class-declaration": {
      "name": "meta.class.cp3",
      "match": "\\b(class)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "storage.type.class.cp3"
        },
        "2": {
          "name": "entity.name.class.cp3"
        }
      }
    },
    "interface-declaration": {
      "name": "meta.interface.cp3",
      "match": "\\b(interface)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "storage.type.interface.cp3"
        },
        "2": {
          "name": "entity.name.type.interface.cp3"
        }
      }
    },
    "enum-declaration": {
      "name": "meta.enum.cp3",
      "begin": "\\b(enum)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.enum.cp3"
        },
        "2": {
          "name": "entity.name.type.enum.cp3"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#enum-member"
        },
        {
          "include": "#code"
        }
      ]
    },
    "enum-member": {
      "name": "variable.other.enummember.cp3",
      "match": "(?<![A-Za-z0-9_$])([A-Za-z_$][A-Za-z0-9_$]*)(?=[ \\t]*(?:=|,|\\}))"
    },
    "type-alias-declaration": {
      "name": "meta.type.declaration.cp3",
      "match": "\\b(type)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "storage.type.cp3"
        },
        "2": {
          "name": "entity.name.type.alias.cp3"
        }
      }
    },
    "variable-declaration": {
      "name": "meta.var.cp3",
      "begin": "\\b(let|var|const)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.cp3"
        },
        "2": {
          "name": "variable.other.readwrite.cp3"
        }
      },
      "end": "(?=[;,=])|(?=\\})",
      "patterns": [
        {
          "include": "#type-annotation"
        },
        {
          "include": "#code"
        }
      ]
    },
    "accessor-declaration": {
      "name": "meta.accessor.cp3",
      "match": "\\b(get|set)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.cp3"
        },
        "2": {
          "name": "entity.name.function.cp3"
        }
      }
    },
    "constructor-declaration": {
      "name": "meta.constructor.cp3",
      "match": "\\b(constructor)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.cp3"
        }
      }
    },
    "parameter-list": {
      "name": "meta.parameters.cp3",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#parameter"
        },
        {
          "include": "#code"
        }
      ]
    },
    "parameter": {
      "name": "meta.parameter.cp3",
      "begin": "(?<=[(,])[ \\t]*(?:(ref)[ \\t]+)?([A-Za-z_$][A-Za-z0-9_$]*)[ \\t]*(\\?)?",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.cp3"
        },
        "2": {
          "name": "variable.parameter.cp3"
        },
        "3": {
          "name": "keyword.operator.optional.cp3"
        }
      },
      "end": "(?=[,)])|(?==)",
      "patterns": [
        {
          "include": "#type-annotation"
        },
        {
          "include": "#code"
        }
      ]
    },
    "type-annotation": {
      "name": "meta.type.annotation.cp3",
      "begin": "(:)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.type.annotation.cp3"
        }
      },
      "end": "(?<=[A-Za-z0-9_$])(?![A-Za-z0-9_$])|(?=[;={)}\\]])",
      "patterns": [
        {
          "include": "#types"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#type-name"
        }
      ]
    },
    "type-name": {
      "name": "entity.name.type.cp3",
      "match": "(?<![A-Za-z0-9_$])[A-Za-z_$][A-Za-z0-9_$]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.cp3",
          "match": "\\b(?:true|false|null|undefined|NaN|Infinity)\\b"
        },
        {
          "name": "storage.type.cp3",
          "match": "\\b(?:let|var|const|type)\\b"
        },
        {
          "name": "storage.type.function.cp3",
          "match": "\\bfunction\\b"
        },
        {
          "name": "storage.type.class.cp3",
          "match": "\\bclass\\b"
        },
        {
          "name": "storage.type.interface.cp3",
          "match": "\\binterface\\b"
        },
        {
          "name": "storage.type.enum.cp3",
          "match": "\\benum\\b"
        },
        {
          "name": "storage.modifier.cp3",
          "match": "\\b(?:static|abstract|public|private|protected|async|get|set|weak|ref|readonly)\\b"
        },
        {
          "name": "storage.modifier.extends.cp3",
          "match": "\\b(?:extends|implements)\\b"
        },
        {
          "name": "keyword.control.cp3",
          "match": "\\b(?:if|else|while|do|for|switch|case|default|break|continue|return|throw|try|catch|finally|await)\\b"
        },
        {
          "name": "keyword.operator.expression.of.cp3",
          "match": "\\bof\\b"
        },
        {
          "name": "keyword.operator.expression.in.cp3",
          "match": "\\bin\\b"
        },
        {
          "name": "keyword.control.import.cp3",
          "match": "\\b(?:import|export|from|as|native)\\b"
        },
        {
          "name": "keyword.operator.new.cp3",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.operator.typeof.cp3",
          "match": "\\btypeof\\b"
        },
        {
          "name": "variable.language.this.cp3",
          "match": "\\bthis\\b"
        },
        {
          "name": "keyword.reserved.cp3",
          "match": "\\b(?:any|delete|yield)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.cp3",
          "match": "\\b(?:number|string|boolean|void|unknown)\\b"
        },
        {
          "name": "support.type.prefixed.cp3",
          "match": "\\b(?:r|ts|c)_'[^']*'"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.cp3",
          "match": "\\b(?:parseInt|parseFloat|isNaN|isFinite|print|sleep|setTimeout|setInterval|clearTimeout|clearInterval|worker)\\b"
        },
        {
          "name": "support.class.builtin.cp3",
          "match": "\\b(?:Promise|EventEmitter|Symbol|BigInt|Object|String|Number|Boolean|Array|Int8Array|Uint8Array|Uint8ClampedArray|Int16Array|Uint16Array|Int32Array|Uint32Array|Float32Array|Float64Array|BigInt64Array|BigUint64Array|ArrayBuffer|SharedArrayBuffer|DataView)\\b"
        },
        {
          "name": "support.class.builtin.cp3 support.namespace.cp3",
          "match": "\\b(?:console|Math|JSON|Date|Map|Set|RegExp|Error|parallel)\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "include": "#member-call"
        },
        {
          "include": "#member-property"
        }
      ]
    },
    "member-call": {
      "name": "entity.name.function.cp3",
      "match": "(?<=\\.)[ \\t]*([A-Za-z_$][A-Za-z0-9_$]*)[ \\t]*(?=\\()"
    },
    "member-property": {
      "name": "variable.other.property.cp3",
      "match": "(?<=\\.)[ \\t]*([A-Za-z_$][A-Za-z0-9_$]*)"
    },
    "calls": {
      "patterns": [
        {
          "include": "#call"
        }
      ]
    },
    "call": {
      "name": "entity.name.function.cp3",
      "match": "(?<![.A-Za-z0-9_$])([A-Za-z_$][A-Za-z0-9_$]*)[ \\t]*(?=\\()"
    },
    "identifiers": {
      "patterns": [
        {
          "include": "#identifier"
        }
      ]
    },
    "identifier": {
      "name": "variable.other.readwrite.cp3",
      "match": "(?<![A-Za-z0-9_$])[A-Za-z_$][A-Za-z0-9_$]*"
    },
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#inheritance"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#members"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#identifiers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.type.function.arrow.cp3",
          "match": "=>"
        },
        {
          "name": "keyword.operator.spread.cp3",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.cp3",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.cp3",
          "match": ">>>=|>>>|>>=|<<=|\\*\\*=|&&=|\\|\\|=|\\?\\?=|===|!==|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\?\\.|\\+\\+|--|\\*\\*|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=>|[-+*/%&|^~!<>=?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.cp3",
          "match": "[;,.]"
        }
      ]
    }
  }
}
