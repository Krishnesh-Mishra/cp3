import console from "std/console";

// 1. String.fromCharCode
console.log(String.fromCharCode(72, 105));

// 2. native toString
let a: i64 = 123;
let b: u64 = 18446744073709551615;
let f: f32 = 1.5;
console.log(a.toString(), b.toString(), f.toString());

// 3. exact 64-bit literal
let big: u64 = 18446744073709551615;
let big2: i64 = 9223372036854775807;
console.log(big.toString(), big2.toString());

// 4. wrapping u64 multiplication (FNV)
let h: u64 = 14695981039346656037;
let p: u64 = 1099511628211;
h = h * p;
console.log(h.toString());
