{
  "name": "cp3-vscode",
  "displayName": "cp3",
  "description": "cp3 language support for VS Code: syntax highlighting, comments/brackets, and live compiler diagnostics through the cp3c language server.",
  "version": "0.2.1",
  "publisher": "cp3",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "cp3",
    "language-server",
    "lsp",
    "cpp"
  ],
  "activationEvents": [
    "onLanguage:cp3",
    "onLanguage:json",
    "onTaskType:cp3",
    "onDebugResolve:cp3",
    "onCommand:cp3.applyPackageJsonSchema"
  ],
  "main": "./dist/extension.js",
  "icon": "images/cp3-logo.png",
  "contributes": {
    "iconThemes": [
      {
        "id": "cp3-icons",
        "label": "cp3",
        "path": "./icons/cp3-icons.json"
      }
    ],
    "languages": [
      {
        "id": "cp3",
        "aliases": [
          "cp3",
          "CP3"
        ],
        "extensions": [
          ".cp3"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "cp3",
        "path": "./snippets/cp3.json"
      }
    ],
    "grammars": [
      {
        "language": "cp3",
        "scopeName": "source.cp3",
        "path": "./syntaxes/cp3.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cp3.restartServer",
        "title": "cp3: Restart Language Server"
      },
      {
        "command": "cp3.applyPackageJsonSchema",
        "title": "cp3: Apply cp3 Manifest Schema to package.json"
      },
      {
        "command": "cp3.organizeImports",
        "title": "CP3: Organize Imports"
      },
      {
        "command": "cp3.run",
        "title": "CP3: Run Current File",
        "icon": "$(play)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "cp3",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "check"
            ],
            "description": "The cp3c action to run on the active cp3 file in the workspace folder."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "cp3c",
        "owner": "cp3c",
        "source": "cp3c",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning): (CP\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "configuration": {
      "title": "cp3",
      "properties": {
        "cp3.compilerPath": {
          "type": "string",
          "default": "cp3c",
          "markdownDescription": "Path to the cp3 compiler executable used as the language server and debug adapter. A bare name (the default, `cp3c`) is resolved on PATH, also trying `cp3c.exe` on Windows. If it is not on PATH, the extension searches parent folders for a CP3 source checkout and uses its `build/bin/cp3c` executable when present. An explicit path is used as-is. The extension runs `<path> lsp --stdio` and `<path> dap --stdio`."
        },
        "cp3.suggestWorkspaceExports": {
          "type": "boolean",
          "default": true,
          "description": "Suggest exported declarations from CP3 files in the workspace and add the matching import when accepted."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "cp3.run",
          "when": "editorLangId == cp3",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "editor.action.formatDocument",
          "when": "editorLangId == cp3",
          "group": "1_modification@1"
        },
        {
          "command": "cp3.organizeImports",
          "when": "editorLangId == cp3",
          "group": "1_modification@2"
        },
        {
          "command": "cp3.run",
          "when": "editorLangId == cp3",
          "group": "1_modification@3"
        }
      ],
      "commandPalette": [
        {
          "command": "cp3.organizeImports",
          "when": "editorLangId == cp3"
        },
        {
          "command": "cp3.applyPackageJsonSchema"
        },
        {
          "command": "cp3.run",
          "when": "editorLangId == cp3"
        }
      ]
    },
    "debuggers": [
      {
        "type": "cp3",
        "label": "C+++ (cp3)",
        "languages": [
          "cp3"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .cp3 program to build and debug.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the build and the program.",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cp3",
            "request": "launch",
            "name": "cp3: Debug current file",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "smoke:resolve": "node scripts/resolve-smoke.mjs",
    "smoke:grammar": "node scripts/grammar-smoke.mjs",
    "smoke:brand": "node scripts/brand-smoke.mjs",
    "smoke": "npm run typecheck && npm run smoke:resolve && npm run smoke:grammar && npm run smoke:brand",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
