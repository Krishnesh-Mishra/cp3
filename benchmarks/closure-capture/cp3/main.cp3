import console from "std/console";

// closure-capture (cp3 entry) -- two closure shapes back to back over a
// 10,000,000-element source:
//   A: map / filter / reduce with arrow functions that capture offset and cap
//   B: 1000 closures, each capturing its own key, stored in an array and
//      invoked after the creating scope has ended (escaping closures)
// Prints both sums on one line. Same workload and same output as the C++,
// Rust, Go, JavaScript and Python entries (expected line in the task README).
//
// NOT RUNNABLE TODAY: closures have not landed (wave 8), so the compiler stops
// at the first arrow function and the runner records that diagnostic instead
// of a timing. The entry is written to the frozen spec and its row fills in
// when the wave lands.

const SOURCE = 10000000;
const OFFSET = 7;
const CAP = 3;

const numbers: number[] = [];
let i = 0;
while (i < SOURCE) {
  numbers.push(i);
  i = i + 1;
}

const totalMapReduce = numbers
  .map((x) => x + OFFSET)
  .filter((x) => x % CAP === 0)
  .reduce((acc, x) => acc + x, 0);

const closures: ((x: number) => number)[] = [];
let key = 0;
while (key < 1000) {
  const bound = key;
  closures.push((x) => x * bound + OFFSET);
  key = key + 1;
}

let totalEscaping = 0;
let index = 0;
while (index < closures.length) {
  let call = 0;
  while (call < 3000) {
    totalEscaping = totalEscaping + closures[index](index);
    call = call + 1;
  }
  index = index + 1;
}

console.log(totalMapReduce, totalEscaping);
