import console from "std/console";
import { env } from "std/env";

// env-injection (cp3 entry) -- read one injected environment variable N times
// and fold its bytes into a checksum.
//
// The suite runner injects CP3_BENCH_ENV into every child process for this
// task. Each iteration performs a fresh env.get<string>(...) read (the lookup
// itself is the workload) and folds the value's length, byte sum, first byte
// and last byte into the checksum. A missing variable throws, so a run without
// the injection fails instead of measuring an empty string.
//
// Same workload and same output as the C++, Rust, Go, JavaScript and Python
// entries.

const ITERATIONS = 500000;
const KEY = "CP3_BENCH_ENV";
const MOD = 1000003;

function envChecksum(iterations: number): number {
  let checksum = 0;
  let i = 0;
  while (i < iterations) {
    const value = env.get<string>(KEY);
    let bytes = 0;
    let j = 0;
    while (j < value.length) {
      bytes = bytes + value[j];
      j = j + 1;
    }
    checksum = (checksum * 31 + value.length) % MOD;
    checksum = (checksum * 31 + bytes) % MOD;
    checksum = (checksum * 31 + value[0]) % MOD;
    checksum = (checksum * 31 + value[value.length - 1]) % MOD;
    i = i + 1;
  }
  return checksum;
}

console.log(envChecksum(ITERATIONS));
