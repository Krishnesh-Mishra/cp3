import console from "std/console";

// generics-mono (cp3 entry) -- the same 2,000,000-iteration sum run twice:
// once through a generic wrapper type plus a generic function, once through a
// hand-written concrete type. Prints both sums on one line. Same workload and
// same output as the C++, Rust, Go, JavaScript and Python entries (expected
// line in the task README).
//
// NOT RUNNABLE TODAY: generic classes (classes wave) and generic functions
// (wave 10) have not landed, so the compiler stops at the Box<T> declaration
// and the runner records that diagnostic instead of a timing. The entry is
// written to the frozen spec - docs/language-spec/15 declares methods with the
// `function` keyword and the constructor as `constructor(...)`.

class Box<T> {
  value: T;

  function get(): T {
    return this.value;
  }
}

function sumBox<T>(box: Box<T>): T {
  return box.get();
}

class NumberBox {
  value: number;

  constructor(value: number) {
    this.value = value;
  }

  function get(): number {
    return this.value;
  }
}

const ITERATIONS = 2000000;
const MOD = 1000000007;

let totalGeneric = 0;
let i = 0;
while (i < ITERATIONS) {
  const box = new Box<number>();
  box.value = i;
  totalGeneric = (totalGeneric + sumBox<number>(box)) % MOD;
  i = i + 1;
}

let totalConcrete = 0;
i = 0;
while (i < ITERATIONS) {
  const box = new NumberBox(i);
  totalConcrete = (totalConcrete + box.get()) % MOD;
  i = i + 1;
}

console.log(totalGeneric, totalConcrete);
