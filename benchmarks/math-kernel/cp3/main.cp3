import console from "std/console";
import Math from "std/math";

// math-kernel (cp3 entry) -- evaluate sqrt, floor, abs, pow and clamp over
// 5,000,000 points, quantize each result to an integer and fold one checksum.
//
// Same workload and same output in every language entry. sqrt is correctly
// rounded, pow uses an integer exponent, and every term is quantized to an
// integer before folding, so the checksum is exact across libms.

const COUNT = 5000000;
const MOD = 1000000007;

let checksum = 0;
let sqrtTotal = 0.0;
let i = 1;
while (i <= COUNT) {
  let x = i * 0.000001;
  let s = Math.sqrt(i);
  sqrtTotal = sqrtTotal + s;
  let f = Math.floor(x + 0.5);
  let a = Math.abs(x - 2.5);
  let p = Math.trunc(Math.pow(i, 2));
  let c = Math.clamp(x * 1000.0, 0.0, 1000.0);
  let mixed = s + f + a + c;
  let quantum = Math.trunc(mixed * 1000000.0);
  checksum = (checksum * 31 + quantum + p) % MOD;
  i = i + 1;
}
let sqrtScaled = Math.trunc(sqrtTotal * 1000.0);
checksum = (checksum * 31 + sqrtScaled) % MOD;
console.log(`${checksum}`);
