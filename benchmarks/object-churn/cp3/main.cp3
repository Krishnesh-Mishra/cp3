import console from "std/console";

// object-churn (cp3 entry) -- create 5,000,000 small objects in a hot loop:
// each iteration's temporary dies in scope, and every second object escapes
// into an array. One checksum at the end. Same workload and same output as the
// C++, Rust, Go, JavaScript and Python entries (expected value in the task
// README).
//
// NOT RUNNABLE TODAY: classes have not landed (wave 2), so the compiler stops
// at the class declaration and the runner records that diagnostic instead of a
// timing. The entry is written to the frozen spec and its row fills in when
// the wave lands.

const OBJECTS = 5000000;
const MOD = 1000000007;

class Cell {
  value: number;

  constructor(value: number) {
    this.value = value;
  }
}

const kept: Cell[] = [];
let acc = 0;
let i = 0;
while (i < OBJECTS) {
  const temp = new Cell(i);
  acc = (acc + temp.value) % MOD;
  if (i % 2 === 0) {
    kept.push(new Cell(i));
  }
  i = i + 1;
}

let checksum = acc;
let k = 0;
while (k < kept.length) {
  checksum = (checksum * 31 + kept[k].value) % MOD;
  k = k + 1;
}

console.log(checksum);
