import console from "std/console";
import { Map } from "std/collections";

// word-frequency (cp3 entry) -- count 3,000,000 picks from a 64-word
// vocabulary generated by a pinned integer LCG, then fold the counts into one
// deterministic checksum. Same workload and same output as the C++, Rust, Go,
// JavaScript and Python entries (expected value in the task README).
//
// std/collections has landed, so the Map surface this entry needs is real.
// The remaining blocker is the array surface (array literals, indexing and
// push), which the arrays wave owns; the row fills in when that lands.
//
// The Map is named by inference from the constructor rather than by a type
// annotation: `let x: Map<string, number>` is still a known type-name gap (the
// import brings the constructor into value scope, not the type name). That gap
// is tracked in the audit follow-ups; the bench uses the inference form the
// corpus itself uses.
//
// The final fold walks the vocabulary in a fixed order, so no map iteration
// order can leak into the output; only the count arithmetic matters.

const CORPUS = 3000000;
const VOCAB = 64;

const words: string[] = [];
let w = 0;
while (w < VOCAB) {
  words.push("word" + String(w).padStart(2, "0"));
  w = w + 1;
}

const counts = new Map<string, number>();

let state = 1;
let pick = 0;
while (pick < CORPUS) {
  state = (state * 48271) % 2147483647;
  const word = words[state % VOCAB];
  const current = counts.get(word) ?? 0;
  counts.set(word, current + 1);
  pick = pick + 1;
}

let checksum = 0;
let i = 0;
while (i < VOCAB) {
  const count = counts.get(words[i]) ?? 0;
  checksum = (checksum * 31 + count) % 1000000007;
  i = i + 1;
}

console.log(checksum);
