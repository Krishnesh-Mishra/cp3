import console from "std/console";
import Math from "std/math";

// typed-array-sum (cp3 entry) -- fill a fixed Float64Array and Uint8Array,
// sum the floats for 32 rounds, then fold the float and byte totals into one
// integer checksum.
//
// Same workload and same output in every language entry. The float pattern is
// a multiple of 0.25 and every partial sum stays far below 2^53, so the
// addition is exact in IEEE-754 doubles.
//
// cp3 reads typed-array elements with a runtime index as
// `number | null | undefined`, and arithmetic on that union does not codegen
// yet. The buffers themselves are the built-in typed arrays; the scalar reads
// go through DataView over their ArrayBuffer backreferences (little-endian,
// matching the platform byte order of the views).
//
// Source: benchmarks/cases/typed-array-sum/cp3/src/index.cp3
//
// Native f64 for the float accumulation (total/acc), i64 for the loop indices
// and ROUNDS. SIZE stays `number` because the Float64Array/Uint8Array
// constructors only accept a `number` length (an i64 length is rejected, and
// the `Number(...)` bridge passes sema but not codegen). The byte total and
// the checksum stay `number`: DataView.getUint8 and Math.trunc are declared
// `number`, and cp3 has no explicit number -> i64 cast. MOD therefore stays
// `number` too - `%` refuses a `number` operand when the other side is a
// native integer (CP3406).

const SIZE: number = 1000000;
const ROUNDS: i64 = 32;
const MOD = 1000000007;

let values = new Float64Array(SIZE);
let bytes = new Uint8Array(SIZE);
let floats = new DataView(values.buffer);
let octets = new DataView(bytes.buffer);

let i: i64 = 0;
while (i < SIZE) {
  values[i] = (i % 97) * 0.5 + (i % 13) * 0.25;
  bytes[i] = (i * 31 + 7) % 256;
  i = i + 1;
}

let total: f64 = 0.0;
let round: i64 = 0;
while (round < ROUNDS) {
  let acc: f64 = 0.0;
  i = 0;
  while (i < SIZE) {
    acc = acc + floats.getFloat64(i * 8, true);
    i = i + 1;
  }
  total = total + acc;
  round = round + 1;
}

let byteTotal: number = 0;
i = 0;
while (i < SIZE) {
  byteTotal = byteTotal + octets.getUint8(i);
  i = i + 1;
}

let scaled = Math.trunc(total * 4.0);
let checksum = (scaled + byteTotal) % MOD;
checksum = (checksum * 31 + SIZE + ROUNDS) % MOD;
console.log(`${checksum}`);
