import console from "std/console";

// object-churn (cp3 entry) -- create 5,000,000 small objects in a hot loop:
// each iteration's temporary dies in scope, and every second object escapes
// into an array. One checksum at the end. Same workload and same output as the
// C++, Rust, Go, JavaScript and Python entries (expected value in the task
// README).
//
// Source: benchmarks/cases/object-churn/cp3/src/index.cp3
//
// Native i64 throughout: the Cell payload, the loop counters, the accumulator
// and the checksum are all integer state, and every intermediate stays below
// 2^63.

const OBJECTS: i64 = 5000000;
const MOD: i64 = 1000000007;

class Cell {
  value: i64;

  constructor(value: i64) {
    this.value = value;
  }
}

const kept: Cell[] = [];
let acc: i64 = 0;
let i: i64 = 0;
while (i < OBJECTS) {
  const temp = new Cell(i);
  acc = (acc + temp.value) % MOD;
  if (i % 2 === 0) {
    kept.push(new Cell(i));
  }
  i = i + 1;
}

let checksum: i64 = acc;
let k: i64 = 0;
while (k < kept.length) {
  checksum = (checksum * 31 + kept[k].value) % MOD;
  k = k + 1;
}

console.log(checksum);
