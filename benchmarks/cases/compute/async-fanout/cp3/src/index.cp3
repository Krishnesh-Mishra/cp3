import console from "std/console";

// async-fanout (cp3 entry) -- two phases folded into one integer.
//
// Phase 1: 10,000 zero-delay timers (sleep(0)), all created before any of them
//          fires and joined at once with Promise.all; each timer folds its
//          index into a shared sum when it resolves.
// Phase 2: 10,000 sequential awaits of an already-resolved promise, folding the
//          loop index at every step (the coroutine-frame / microtask churn
//          probe).
//
// The output is identical to the JS, Python and Go entries.
//
// ADAPTATION 1: the 10,000-element literal below is generated, not
// hand-written, because it is the only spelling the landed surface accepts:
// `Promise.all` lowers only when its argument is an array LITERAL
// (src/codegen/src/emit/async.cpp, emitPromiseStatic rejects "Promise.all over
// a non-array-literal input" with CP3002), so an Array<Promise<T>> built at run
// time cannot be joined. Every real fan-out program would build the array in a
// loop; the literal is the workaround.
//
// ADAPTATION 2: the join result is not assigned. Sema gives `Promise.all` no
// value type (src/sema/src/checks/call_check.cpp, tryInferPromiseStaticCall
// handles only Promise.resolve/reject), so the awaited value is `unknown` and
// `values.length` / `values[i]` are CP3002. The fold therefore happens inside
// `tick` when each timer resolves: the same 10,000 additions, in resolution
// order, produce the same integer as summing the joined array.
//
// Both adaptations are listed in
// build/scratch/rounds/WAVE-BENCH-JSON-ASYNC-REPORT.md.
//
// Generator: build/scratch/rounds/gen_async_cp3.py
//
// Source: benchmarks/cases/async-fanout/cp3/src/index.cp3
//
// Native i64 for the timer index, the shared fan sum, the phase-2 index and
// the checksum; Promise<i64> is supported. Every intermediate stays far below
// 2^63.

const FANOUT: i64 = 10000;
const CHAIN: i64 = 10000;
const MOD: i64 = 1000003;

let fanSum: i64 = 0;

async function tick(n: i64): Promise<i64> {
  await sleep(0);
  fanSum = fanSum + n;
  return n;
}

let checksum: i64 = 0;

// Phase 1: 10,000 concurrent zero-delay timers joined at once.
await Promise.all([
