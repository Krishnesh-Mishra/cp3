import console from "std/console";
function xs_next(x: u64): u64 { let y: u64 = x; y = y ^ (y << 13); y = y ^ (y >> 7); y = y ^ (y << 17); return y; }
class E { kind: u64; id: u64; a: u64; b: u64; w0: u64; wlen: u64; constructor(k: u64, id: u64, a: u64, b: u64, w0: u64, wl: u64) { this.kind = k; this.id = id; this.a = a; this.b = b; this.w0 = w0; this.wlen = wl; } }
const log: E[] = [];
let r: u64 = 12345;
let i: u64 = 0;
while (i < 100000) {
  r = xs_next(r);
  const k: u64 = r % 8;
  const id: u64 = (r >> 3) % 100000;
  if (k < 4) { log.push(new E(1, id, ((r >> 20) % 201), ((r >> 40) % 201), 0, 0)); }
  else if (k < 6) { log.push(new E(2, id, 0, 0, (xs_next(r) % 26) + 97, 4 + (r % 12))); }
  else if (k < 7) { log.push(new E(3, id, (r >> 20) % 256, 0, 0, 0)); }
  else { log.push(new E(0, id, 0, 0, 0, 0)); }
  i = i + 1;
}
let total: number = 0;
let p: u64 = 0;
while (p < 4) {
  let j: u64 = 0;
  while (j < log.length) {
    const e: E = log[j];
    if (e.kind === 0) { total = total + 1; }
    else if (e.kind === 1) { total = total + e.id + e.a + e.b - 200; }
    else if (e.kind === 2) { total = total + e.id + e.wlen + e.w0; }
    else { total = total + e.id + e.a; }
    j = j + 1;
  }
  p = p + 1;
}
console.log(log.length);
console.log(`${total}`);
