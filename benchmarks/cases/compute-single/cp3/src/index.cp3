import console from "std/console";

// compute-single (cp3 entry) -- total Collatz steps for every start value in
// 1..1,000,000, printed as one integer. Same workload and same output as the
// C++, Rust, Go, JavaScript and Python entries.
//
// This entry is written to compile and run today: it sticks to what the
// current compiler implements (functions, while, if/else, %, comparisons,
// arithmetic and template-free console.log).
//
// Source: benchmarks/cases/compute-single/cp3/src/index.cp3
//
// Native i64 arithmetic: every intermediate (3n+1 for n < 2^53, the step
// counts and the running total) fits in 64 bits, and cp3's integer `/` is
// floor division, which is exact for the `/2` branch because n is even there.

function collatzSteps(start: i64): i64 {
  let n = start;
  let steps: i64 = 0;
  while (n !== 1) {
    if (n % 2 === 0) {
      n = n / 2;
    } else {
      n = 3 * n + 1;
    }
    steps = steps + 1;
  }
  return steps;
}

let total: i64 = 0;
let start: i64 = 1;
while (start <= 1000000) {
  total = total + collatzSteps(start);
  start = start + 1;
}

console.log(total);
