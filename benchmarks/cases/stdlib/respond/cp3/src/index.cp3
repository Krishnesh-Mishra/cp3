// respond - JSON render + FNV-1a
//
// Requires `typeSystem: "rust"` (see package.json), which gives the exact
// native widths used below and keeps 1469598103934665603 exact.
//
// FNV-1a relies on multiplication modulo 2^64. cp3's `*` is checked and
// throws on overflow by design, so the wrapping intent is spelled with the
// native `.wrappingMul()` method. `String.fromCharCode` builds each name
// byte, and `parseTo(value, string)` renders the u64 fields exactly (the
// number-only `toString` is not used).
import console from "std/console";

function xsNext(x: u64): u64 {
  let y: u64 = x;
  y = y ^ (y << 13);
  y = y ^ (y >> 7);
  y = y ^ (y << 17);
  return y;
}

let out: string = "";
let r: u64 = 12345;
let i: u64 = 0;
while (i < 10000) {
  r = xsNext(r);
  const id: u64 = r % 100000;
  r = xsNext(r);
  const length: u64 = 4 + (r % 9);
  let name: string = "";
  let j: u64 = 0;
  while (j < length) {
    r = xsNext(r);
    if (j % 8 === 7) {
      name = name + String.fromCharCode(r % 2 === 0 ? 34 : 92);
    } else {
      name = name + String.fromCharCode(97 + (r % 26));
    }
    j = j + 1;
  }
  // JSON-escape the generated name: a literal quote or backslash is
  // prefixed with one backslash, matching the other implementations.
  let rendered: string = "";
  let n: u64 = 0;
  while (n < name.length) {
    const c: number = name[n];
    if (c === 34 || c === 92) {
      rendered = rendered + "\\";
    }
    rendered = rendered + String.fromCharCode(c);
    n = n + 1;
  }
  r = xsNext(r);
  const score: u64 = r % 1000;
  const active: bool = (r >> 8) % 2 === 0;
  out = out + "{\"id\":" + parseTo(id, string) + ",\"name\":\"" + rendered +
        "\",\"score\":" + parseTo(score, string) + ",\"active\":" +
        (active ? "true" : "false") + "},";
  i = i + 1;
}

let h: u64 = 1469598103934665603;
let k: u64 = 0;
while (k < out.length) {
  h = (h ^ parseTo<r_'u64'>(out.charCodeAt(k))).wrappingMul(1099511628211);
  k = k + 1;
}
console.log(out.length);
console.log(`${h}`);
