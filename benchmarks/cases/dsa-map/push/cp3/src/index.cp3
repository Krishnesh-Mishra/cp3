import console from "std/console";
function xs_next(x: u64): u64 { let y: u64 = x; y = y ^ (y << 13); y = y ^ (y >> 7); y = y ^ (y << 17); return y; }
let r: u64 = 12345;
const keys: u64[] = [];
const vals: u64[] = [];
const marks: i64[] = [];
let cnt: i64 = 0;
let i: u64 = 0;
while (i < 1000000) { r = xs_next(r); keys.push(r % 1000000); vals.push(i % 97); cnt = cnt + 1; if (i % 64 === 0) marks.push(cnt - 1); i = i + 1; }
let total: u64 = 0; let j: i64 = 0;
while (j < cnt) { total = total + keys[j]; j = j + 1; }
let mt: u64 = 0; let k: i64 = 0;
while (k < marks.length) { mt = mt + vals[marks[k]]; k = k + 1; }
console.log(cnt); console.log(marks.length); console.log(total); console.log(mt);
