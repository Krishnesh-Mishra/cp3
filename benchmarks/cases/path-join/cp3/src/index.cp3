import console from "std/console";
import path from "std/path";

// path-join (cp3 entry) -- join, normalize, basename and extname one fixed
// path-segment list N times and fold stable string lengths and characters.
//
// Same workload and same output as the C++, Rust, Go, JavaScript and Python
// entries. Only lengths and the first character of each result are folded, so
// the checksum is identical on Windows and POSIX (the separator is one
// character in every language's path surface).
//
// Source: benchmarks/cases/path-join/cp3/src/index.cp3
//
// Native i64 for the loop counter only. The checksum stays `number`: every
// fold term is a string `.length` or `[0]`, both declared `number`, and cp3
// has no explicit number -> i64 cast. MOD stays `number` to match.

const ITERATIONS: i64 = 170000;
const MOD = 1000003;

function pathChecksum(iterations: i64): number {
  let checksum: number = 0;
  let i: i64 = 0;
  while (i < iterations) {
    const joined = path.join("var", "log", "cp3", "service", "events-2026-10-23.log");
    const normalized = path.normalize(joined);
    const base = path.basename(joined);
    const ext = path.extname(joined);

    checksum = (checksum * 31 + joined.length) % MOD;
    checksum = (checksum * 31 + normalized.length) % MOD;
    checksum = (checksum * 31 + base.length) % MOD;
    checksum = (checksum * 31 + ext.length) % MOD;
    checksum = (checksum * 31 + joined[0]) % MOD;
    checksum = (checksum * 31 + base[0]) % MOD;
    checksum = (checksum * 31 + ext[0]) % MOD;
    i = i + 1;
  }
  return checksum;
}

console.log(pathChecksum(ITERATIONS));
