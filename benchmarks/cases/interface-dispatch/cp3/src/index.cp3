import console from "std/console";

// interface-dispatch (cp3 entry) -- fill an array with 2,000,000 shapes of
// three concrete types behind an interface, sum every area() through the
// interface, then repeat the hot loop as direct calls on a concrete type and
// print both sums on one line. Same workload and same output as the C++, Rust,
// Go, JavaScript and Python entries (expected line in the task README).
//
// Source: benchmarks/cases/interface-dispatch/cp3/src/index.cp3
//
// Native i64 for every shape dimension and for the loop counters. `area()` and
// the two totals stay `number`: an interface method whose return is a native
// type has no C++ spelling in the generated wrapper (CP3401), so the shared
// interface must return `number`. The areas are small integers, so the double
// totals are still exact.

interface Shape {
  function area(): number;
}

class Circle implements Shape {
  radius: i64;

  constructor(radius: i64) {
    this.radius = radius;
  }

  function area(): number {
    return 3 * this.radius * this.radius;
  }
}

class Square implements Shape {
  side: i64;

  constructor(side: i64) {
    this.side = side;
  }

  function area(): number {
    return this.side * this.side;
  }
}

class Rect implements Shape {
  width: i64;
  height: i64;

  constructor(width: i64, height: i64) {
    this.width = width;
    this.height = height;
  }

  function area(): number {
    return this.width * this.height;
  }
}

const COUNT: i64 = 2000000;

const shapes: Shape[] = [];
let i: i64 = 0;
while (i < COUNT) {
  const kind = i % 3;
  if (kind === 0) {
    shapes.push(new Circle(i % 5 + 1));
  } else if (kind === 1) {
    shapes.push(new Square(i % 4 + 1));
  } else {
    shapes.push(new Rect(i % 3 + 1, i % 6 + 2));
  }
  i = i + 1;
}

let totalDispatch: number = 0;
i = 0;
while (i < shapes.length) {
  totalDispatch = totalDispatch + shapes[i].area();
  i = i + 1;
}

const circles: Circle[] = [];
i = 0;
while (i < COUNT) {
  circles.push(new Circle(i % 5 + 1));
  i = i + 1;
}

let totalControl: number = 0;
i = 0;
while (i < circles.length) {
  totalControl = totalControl + circles[i].area();
  i = i + 1;
}

console.log(totalDispatch, totalControl);
