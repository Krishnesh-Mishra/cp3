import { createServer } from "std/network";
import console from "std/console";
import os from "std/os";
import process from "std/process";

// health-server-multi (cp3 entry) -- D79 scale mode: one event loop and one
// uWS app per logical CPU, with module-level state copied per loop.
//
// Contract, identical in every language entry:
//   GET /healthz  -> 200 text/plain "ok"
//   GET /         -> 200 text/plain "health-server ok"
//   anything else -> 404 text/plain "not found"
//
// There is no per-request state to isolate here; handlers run on the loop that
// owns their connection, and a connection never changes loops. Binds
// 127.0.0.1 only and takes the port as argv[1] (default 8080).

const PORT = process.argv.length > 1 ? parseInt(process.argv[1]) : 8080;
const LOOPS = os.cpus();
const app = createServer({ threads: LOOPS });

app.get("/healthz", (req, res) => {
  res.text("ok");
});

app.get("/", (req, res) => {
  res.text("health-server ok");
});

app.use((req, res, next) => {
  res.status(404).text("not found");
});

app.listen(PORT, () => {
  console.log(`listening on http://127.0.0.1:${PORT} (${LOOPS} loops)`);
});
