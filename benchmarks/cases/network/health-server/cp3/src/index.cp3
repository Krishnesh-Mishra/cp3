import { createServer } from "std/network";
import console from "std/console";
import process from "std/process";

// health-server (cp3 entry) -- written to the frozen std/network API
// (STDLIB-README "network"): createServer(), .get(), res.text(), .use() as a
// 404 fallback, .listen(port, cb). Handlers may be synchronous; there is no
// per-request state here to share.
//
// Contract, identical in every language entry:
//   GET /healthz  -> 200 text/plain "ok"
//   GET /         -> 200 text/plain "health-server ok"
//   anything else -> 404 text/plain "not found"
//
// Takes the port as argv[1] like every other entry (default 8080).

const PORT = process.argv.length > 1 ? parseInt(process.argv[1]) : 8080;
const app = createServer();

app.get("/healthz", (req, res) => {
  res.text("ok");
});

app.get("/", (req, res) => {
  res.text("health-server ok");
});

// Anything that matched no route above.
app.use((req, res, next) => {
  res.status(404).text("not found");
});

app.listen(parseTo<u16>(PORT  ), () => {
  console.log(`listening on http://127.0.0.1:${PORT}`);
});
