import console from "std/console";
import crypto from "std/crypto";
import { Buffer } from "std/buffer";

// sha256-churn (cp3 entry) -- hash one fixed 1 KiB buffer ITERATIONS times and
// fold the first four digest bytes into a checksum.
//
// Same workload and same output as the Go, JavaScript and Python entries; the
// C++ and Rust entries are omitted because neither standard library ships
// SHA-256 (see TASK_OMIT_LANGUAGES in bench/run_suite.py).
//
// The buffer is the seed repeated to exactly 1024 bytes and never changes, so
// every hash is over identical bytes; what the task measures is the hash
// implementation plus one Buffer/string boundary per iteration. cp3's
// crypto.sha256 returns the digest hex-encoded, so the first eight hex digits
// are the first four digest bytes (big-endian), parsed with parseInt.

const BUFFER_SIZE = 1024;
const ITERATIONS = 60000;
const SEED = "0123456789abcdef";

function sha256Churn(iterations: number): number {
  let data = Buffer.from(SEED.repeat(BUFFER_SIZE / SEED.length));
  let checksum = 0;
  let k = 0;
  while (k < iterations) {
    const digest = crypto.sha256(data);
    const firstFourBytes = parseInt("0x" + digest.slice(0, 8));
    checksum = (checksum * 31 + firstFourBytes) % 1000003;
    k = k + 1;
  }
  return checksum;
}

console.log(sha256Churn(ITERATIONS));
