# ---- cp3 tooling / generated output ----
# Root build tree only: `src/**/build/` contains tracked source files.
/build/
# Staged distributions live in build/out (gitignored via /build/).
# WiX extension cache restored by dist/packaging/windows/build-msi.ps1.
/dist/packaging/windows/.wix/
.cp3/
*.cp3pak

# ---- node / docs viewer ----
node_modules/
docs/local-docs-viewer/node_modules/

# ---- benchmark framework dependencies / build trees ----
benchmarks/.cache/
benchmarks/**/target/
benchmarks/**/build/
benchmarks/**/node_modules/

# ---- native build artifacts ----
*.o
*.obj
*.exe
*.pdb
*.ilk
*.lib
*.a
*.so
*.dylib
*.dll

# ---- CMake ----
# One build tree, always under build/ (docs/rough/DECISIONS.md D55): the canonical tree is
# `cmake -S . -B build`; parallel authors use `cmake -S . -B build/scratch/<name>`
# (covered by the `build/` rule above). Root-level `build-*` directories are
# forbidden, so there is deliberately no ignore pattern for them - a stray one
# must be visible as untracked in `git status`.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
Makefile
*.ninja
compile_commands.json

# ---- editors / OS ----
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db

# ---- python (test harness) ----
__pycache__/
*.pyc

# ---- test scratch ----
/tests/**/.tmp/

# ---- per-case compiler builds from running tests ----
tests/cases/**/.cp3/

# ---- vendored static libraries (D70: pinned builds shipped with cp3c) ----
# Must stay after the *.a / *.lib rules above (last match wins).
!vendor/third_party/**/*.a
!vendor/third_party/**/*.lib
benchmarks/cases/health-server/cp3/merged.txt

# ---- documentation site ----
docs/site/
docs/.venv-docs/

# ---- local scratch (build/corpus logs, probe fixtures; never committed) ----
.log/

# ---- network_config_full_options server fixture output dirs ----
tests/cases/stdlib/02/network/config/network_config_full_options/public/
tests/cases/stdlib/02/network/config/network_config_full_options/views/
