# ---- cp3 tooling / generated output ----
# Root build tree only: `src/**/build/` contains tracked source files.
/build/
.cp3/
*.cp3pak

# ---- node / docs viewer ----
node_modules/
docs/local-docs-viewer/node_modules/

# ---- benchmark framework dependencies / build trees ----
benchmarks/.cache/
benchmarks/**/target/
benchmarks/**/build/
benchmarks/**/node_modules/

# ---- native build artifacts ----
*.o
*.obj
*.exe
*.pdb
*.ilk
*.lib
*.a
*.so
*.dylib
*.dll

# ---- CMake ----
# One build tree, always under build/ (docs/rough/DECISIONS.md D55): the canonical tree is
# `cmake -S . -B build`; parallel authors use `cmake -S . -B build/scratch/<name>`
# (covered by the `build/` rule above). Root-level `build-*` directories are
# forbidden, so there is deliberately no ignore pattern for them - a stray one
# must be visible as untracked in `git status`.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
Makefile
*.ninja
compile_commands.json

# ---- editors / OS ----
.vs/
.vscode/
.idea/
.opencode/
*.user
*.suo
.DS_Store
Thumbs.db

# ---- python (test harness) ----
__pycache__/
*.pyc

# ---- test scratch ----
/tests/**/.tmp/

# ---- per-case compiler builds from running tests ----
tests/cases/**/.cp3/

# ---- vendored static libraries (D70: pinned builds shipped with cp3c) ----
# Must stay after the *.a / *.lib rules above (last match wins).
!third_party/**/*.a
!third_party/**/*.lib
