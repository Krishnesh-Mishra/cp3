{
  "steps": [
    {
      "cwd": "pkg",
      "args": [
        "build",
        "src/index.cp3"
      ],
      "expectExit": 0,
      "stderrContains": [
        "packed"
      ]
    },
    {
      "cwd": "app",
      "args": [
        "install",
        "../pkg/.cp3/out/pak_stub.cp3pak"
      ],
      "expectExit": 0,
      "stderrContains": [
        "installed"
      ]
    },
    {
      "cwd": "app",
      "args": [
        "build",
        "src/index.cp3"
      ],
      "expectExit": 0,
      "stderrNotContains": [
        "CP3601"
      ],
      "filesExist": [
        ".cp3/packages/pak_stub/cp3pak.json",
        ".cp3/packages/pak_stub/package.json",
        ".cp3/packages/pak_stub/src/index.cp3",
        ".cp3/packages/pak_stub/src/widget.cp3"
      ],
      "filesAbsent": [
        ".cp3/packages/pak_stub/index.cp3",
        ".cp3/packages/pak_stub/pak"
      ],
      "fileContains": [
        {
          "path": ".cp3/packages/pak_stub/cp3pak.json",
          "contains": "\"formatVersion\": 2"
        },
        {
          "path": ".cp3/packages/pak_stub/cp3pak.json",
          "contains": "\"main\": \"src/index.cp3\""
        }
      ]
    }
  ]
}
