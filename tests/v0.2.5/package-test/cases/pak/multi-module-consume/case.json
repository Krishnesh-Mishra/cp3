{
  "steps": [
    {
      "cwd": "pkg",
      "args": [
        "build",
        "src/index.cp3"
      ],
      "expectExit": 0,
      "stderrContains": [
        "packed"
      ]
    },
    {
      "cwd": "app",
      "args": [
        "install",
        "../pkg/.cp3/out/pak_multi.cp3pak"
      ],
      "expectExit": 0,
      "stderrContains": [
        "installed"
      ]
    },
    {
      "cwd": "app",
      "args": [
        "build",
        "src/index.cp3"
      ],
      "expectExit": 0,
      "stderrNotContains": [
        "CP3601",
        "CP3304"
      ]
    },
    {
      "cwd": "app",
      "args": [
        "run",
        "src/index.cp3"
      ],
      "expectExit": 0,
      "stdoutContains": [
        "hello",
        "7"
      ]
    }
  ]
}
