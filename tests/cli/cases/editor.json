    {
      "group": "editor",
      "name": "install-current-does-not-invoke-editor",
      "description": "install current does not invoke editor",
      "argv": [
        "editor-plugin",
        "install"
      ],
      "env": {
        "PATH_PREPEND": "editor/bin",
        "FAKE_EDITOR_LOG": "{root}/editor.log"
      },
      "setup": {
        "home_fixtures": [
          "editor-home-current"
        ]
      },
      "requires": "command:editor-plugin",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "already installed"
        },
        "files": {
          "{root}/editor.log": {
            "absent": true
          }
        }
      }
    },
    {
      "group": "editor",
      "name": "install-older-invokes-editor",
