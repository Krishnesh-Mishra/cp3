      ],
      "env": {
        "PATH_PREPEND": "editor/bin",
        "FAKE_EDITOR_LOG": "{root}/editor.log"
      },
      "setup": {
        "home_fixtures": [
          "editor-home-older"
        ]
      },
      "requires": "command:editor-plugin",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "installed"
        },
        "files": {
          "{root}/editor.log": {
            "contains": "--install-extension"
          }
        }
      }
    },
