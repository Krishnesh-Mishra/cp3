    {
      "group": "editor",
      "name": "export-refuses-overwrite",
      "description": "export refuses overwrite",
      "argv": [
        "editor-plugin",
        "export",
        "--out",
        "bundle.vsix"
      ],
      "setup": {
        "files": {
          "bundle.vsix": "old\n"
        }
      },
      "requires": [
        "command:editor-plugin",
        "flag:--out"
      ],
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": "exists"
        },
        "files": {
          "bundle.vsix": {
            "equals": "old\n"
          }
        }
      }
    },
