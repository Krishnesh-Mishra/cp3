{
  "group": "editor",
  "cases": [
    {
      "group": "editor",
      "name": "status-no-editors",
      "description": "status no editors",
      "argv": [
        "editor-plugin",
        "status"
      ],
      "env": {
        "PATH_MODE": "minimal"
      },
      "requires": "command:editor-plugin",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "no editor",
            "cp3"
          ]
        }
      }
    },
    {
      "group": "editor",
      "name": "status-one-fake-editor",
      "description": "status one fake editor",
      "argv": [
        "editor-plugin",
        "status"
      ],
      "env": {
        "PATH_PREPEND": "editor/bin"
      },
      "requires": "command:editor-plugin",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "Visual Studio Code",
            "code"
          ]
        }
      }
    },
