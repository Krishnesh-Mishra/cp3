{
  "group": "recompile",
  "cases": [
    {
      "group": "recompile",
      "name": "archive-without-source",
      "description": "recompile refuses a source package (formatVersion 2), which carries no C++ to compile",
      "argv": [
        "recompile",
        "deps/local-kit.cp3pak"
      ],
      "setup": {
        "fixtures": [
          {
            "name": "local-dep.cp3pak",
            "to": "deps/local-kit.cp3pak"
          }
        ]
      },
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": [
            "carries no C++ source to compile"
          ]
        }
      }
    },
    {
      "group": "recompile",
      "name": "missing-file",
      "description": "recompile without an argument is a usage error",
      "argv": [
        "recompile"
      ],
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "recompile needs a .cp3pak file"
        }
      }
    },
    {
      "group": "recompile",
      "name": "unknown-file",
      "description": "recompile of a file that does not exist fails",
      "argv": [
        "recompile",
        "nope.cp3pak"
      ],
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": "does not exist"
        }
      }
    }
  ]
}
