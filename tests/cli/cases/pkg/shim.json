{
  "group": "shim",
  "cases": [
    {
      "group": "shim",
      "name": "version-forwarded",
      "description": "version forwarded",
      "argv": [
        "version"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "regex": "^cp3c \\d+\\.\\d+\\.\\d+"
        }
      }
    },
    {
      "group": "shim",
      "name": "help-forwarded",
      "description": "help forwarded",
      "argv": [
        "help"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "Usage:",
            "Commands:"
          ]
        }
      }
    },
    {
      "group": "shim",
      "name": "unknown-command-exit-code",
      "description": "unknown command exit code",
      "argv": [
        "bogus"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "unknown command 'bogus'"
        }
      }
    },
    {
      "group": "shim",
      "name": "check-forwarded",
      "description": "check forwarded",
      "argv": [
        "check",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0
      }
    },
    {
      "group": "shim",
      "name": "check-failure-exit-code",
      "description": "check failure exit code",
      "argv": [
        "check",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "bad-syntax"
        ]
      },
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": "CP3201"
        }
      }
    },
    {
      "group": "shim",
      "name": "doctor-fields",
      "description": "doctor fields",
      "argv": [
        "doctor"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "cp3 doctor",
            "install root",
            "cp3c version",
            "toolchain",
            "shipped trees",
            "VS Code CLI"
          ]
        }
      }
    },
    {
      "group": "shim",
      "name": "doctor-reports-configured-toolchain",
      "description": "doctor reports the configured toolchain, not just PATH",
      "argv": [
        "doctor"
      ],
      "setup": {
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "requires": [
        "windows",
        "command:cp3",
        "clang"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "global config"
          ],
          "not_contains": [
            "none found"
          ]
        }
      }
    },
    {
      "group": "shim",
      "name": "doctor-install-root",
      "description": "doctor install root",
      "argv": [
        "doctor"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "regex": "install root : .*_shim"
        }
      }
    },
    {
      "group": "shim",
      "name": "doctor-missing-cp3c",
      "description": "doctor missing cp3c",
      "argv": [
        "doctor"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3-no-cp3c",
      "expect": {
        "exit": 1,
        "stdout": {
          "contains": [
            "cp3c         : MISSING",
            "cp3c version : unknown"
          ]
        }
      }
    },
    {
      "group": "shim",
      "name": "doctor-no-editor",
      "description": "doctor no editor",
      "argv": [
        "doctor"
      ],
      "env": {
        "PATH_MODE": "minimal"
      },
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "VS Code CLI  : not found"
        }
      }
    },
    {
      "group": "shim",
      "name": "doctor-bundled-vsix",
      "description": "doctor bundled vsix",
      "argv": [
        "doctor"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "bundled vsix :",
          "not_contains": "none bundled"
        }
      }
    },
    {
      "group": "shim",
      "name": "doctor-trees",
      "description": "doctor trees",
      "argv": [
        "doctor"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "shipped trees: include=no src=yes vendor_third_party=yes"
          ]
        }
      }
    },
    {
      "group": "shim",
      "name": "init-default-scaffolds-index-entry",
      "description": "cp3 init scaffolds the repository default into the cwd",
      "argv": [
        "init",
        "--yes"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "initialized cp3 project 'work'"
          ]
        },
        "files": {
          "package.json": {
            "json_paths": {
              "main": "src/index.cp3",
              "scripts.start": "cp3c run src/index.cp3",
              "scripts.verify": "cp3c check src/index.cp3",
              "scripts.build": "cp3c build src/index.cp3"
            }
          },
          "src/index.cp3": {
            "contains": "Hello from work!"
          }
        },
        "files_absent": [
          "README.md"
        ]
      }
    },
    {
      "group": "shim",
      "name": "init-named-target",
      "description": "init named target scaffolds that directory",
      "argv": [
        "init",
        "app",
        "--yes"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "files": {
          "app/package.json": {
            "json_paths": {
              "name": "app",
              "main": "src/index.cp3"
            }
          },
          "app/src/index.cp3": {
            "contains": "Hello from app!"
          }
        }
      }
    },
    {
      "group": "shim",
      "name": "init-path-with-spaces",
      "description": "init path with spaces",
      "argv": [
        "init",
        "my app",
        "--yes"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "files": {
          "my app/package.json": {
            "json_paths": {
              "name": "my app"
            }
          },
          "my app/src/index.cp3": {
            "exists": true
          }
        }
      }
    },
    {
      "group": "shim",
      "name": "init-existing-scaffold-preserved",
      "description": "init leaves an existing scaffold untouched",
      "argv": [
        "init",
        "--yes"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "already exists; leaving it unchanged"
          ]
        },
        "files": {
          "package.json": {
            "json_paths": {
              "name": "hello"
            }
          },
          "src/index.cp3": {
            "contains": "hello from hello"
          }
        }
      }
    },
    {
      "group": "shim",
      "name": "init-force-overwrites-scaffold",
      "description": "init force overwrites scaffold",
      "argv": [
        "init",
        "--force"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "overwriting"
          ]
        },
        "files": {
          "package.json": {
            "json_paths": {
              "main": "src/index.cp3"
            }
          },
          "src/index.cp3": {
            "contains": "Hello from work!"
          }
        }
      }
    },
    {
      "group": "shim",
      "name": "init-short-force-alias",
      "description": "init -f overwrites the scaffold files",
      "argv": [
        "init",
        "-f"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "files": {
          "src/index.cp3": {
            "contains": "Hello from work!"
          }
        }
      }
    },
    {
      "group": "shim",
      "name": "init-rejects-two-targets",
      "description": "init rejects two target arguments",
      "argv": [
        "init",
        "a",
        "b"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "usage: cp3c init"
        }
      }
    },
    {
      "group": "shim",
      "name": "init-yes-accepts-defaults",
      "description": "init --yes scaffolds with defaults and no prompts",
      "argv": [
        "init",
        "--yes"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "files": {
          "package.json": {
            "json_paths": {
              "name": "work"
            }
          },
          "--yes": {
            "absent": true
          }
        }
      }
    },
    {
      "group": "shim",
      "name": "path-with-spaces-version",
      "description": "path with spaces version",
      "argv": [
        "version"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3-space",
      "expect": {
        "exit": 0,
        "stdout": {
          "regex": "^cp3c \\d+\\.\\d+\\.\\d+"
        }
      }
    },
    {
      "group": "shim",
      "name": "path-with-spaces-runs-project",
      "description": "path with spaces runs project",
      "argv": [
        "run",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "slow": true,
      "xfail": {
        "id": "paths-with-spaces-break-build",
        "reason": "a shim installed under a path containing a space passes an unquoted include root, so the runtime header is not found"
      },
      "requires": [
        "windows",
        "command:cp3",
        "compiler"
      ],
      "tool": "cp3-space",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "hello from hello"
        }
      }
    },
    {
      "group": "shim",
      "name": "forwards-global-flags-after-command",
      "description": "forwards global flags after command",
      "argv": [
        "check",
        "src/index.cp3",
        "--verbose"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0
      }
    },
    {
      "group": "shim",
      "name": "doctor-reports-cp3c-version",
      "description": "doctor reports cp3c version",
      "argv": [
        "doctor"
      ],
      "requires": [
        "windows",
        "command:cp3"
      ],
      "tool": "cp3",
      "expect": {
        "exit": 0,
        "stdout": {
          "regex": "cp3c version : cp3c \\d+\\.\\d+\\.\\d+"
        }
      }
    }
  ]
}
