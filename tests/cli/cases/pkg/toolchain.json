      "argv": [
        "toolchain",
        "list"
      ],
      "setup": {
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "effective"
          ]
        },
        "stderr": {
          "contains": [
            "warning",
            "falling back"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "list-json-versions",
      "description": "list json versions",
      "argv": [
