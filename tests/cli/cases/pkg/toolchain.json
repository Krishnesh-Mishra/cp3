{
  "group": "toolchain",
  "cases": [
    {
      "group": "toolchain",
      "name": "clang-is-usable-when-installed",
      "description": "clang is usable when installed",
      "argv": [
        "toolchain",
        "list"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "clang",
            "ready"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "clang-builds-and-runs",
      "description": "clang builds and runs a program",
      "argv": [
        "run",
        "src/index.cp3",
        "--toolchain",
        "clang"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "slow": true,
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "hello from hello"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "list-with-no-pin",
      "description": "list with no pin",
      "argv": [
        "toolchain",
        "list"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "clang",
            "effective"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "list-with-project-pin",
      "description": "list with project pin",
      "argv": [
        "toolchain",
        "list"
      ],
      "setup": {
        "fixtures": [
          "toolchain-project"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "clang",
            "project"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "list-with-global-pin",
      "description": "list with global pin",
      "argv": [
        "toolchain",
        "list"
      ],
      "setup": {
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "clang",
            "global"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "project-beats-global",
      "description": "project beats global",
      "argv": [
        "toolchain",
        "list"
      ],
      "setup": {
        "fixtures": [
          "toolchain-project"
        ],
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "project",
            "clang"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "use-clang-project-scope",
      "description": "use clang project scope",
      "argv": [
        "toolchain",
        "use",
        "clang",
        "--project"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "files": {
          "package.json": {
            "contains": [
              "\"toolchain\": {",
              "\"id\": \"clang\"",
              "\"version\":",
              "\"policy\": \"latest\""
            ]
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "use-clang-global-scope",
      "description": "use clang global scope",
      "argv": [
        "toolchain",
        "use",
        "clang",
        "--global"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "files": {
          "{config}/toolchain.conf": {
            "contains": "id=clang"
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "use-unknown-toolchain",
      "description": "use an unknown toolchain name",
      "argv": [
        "toolchain",
        "use",
        "not-a-compiler"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "unknown"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "use-invalid-version",
      "description": "use invalid version",
      "argv": [
        "toolchain",
        "use",
        "clang@not-a-version"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 2
      }
    },
    {
      "group": "toolchain",
      "name": "use-clang-driver-name",
      "description": "use the clang++ driver name",
      "argv": [
        "toolchain",
        "use",
        "clang++"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "selected"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "missing-version-warns-and-falls-back",
      "description": "missing version warns and falls back",
      "argv": [
        "toolchain",
        "use",
        "clang@1.2.3"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "warning",
            "fall"
          ]
        },
        "files": {
          "{config}/toolchain.conf": {
            "contains": "id=clang"
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "missing-version-strict-fails",
      "description": "missing version strict fails",
      "argv": [
        "toolchain",
        "use",
        "clang@1.2.3",
        "--strict-toolchain"
      ],
      "requires": [
        "command:toolchain",
        "clang",
        "flag:--strict-toolchain"
      ],
      "expect": {
        "exit": 1
      }
    },
    {
      "group": "toolchain",
      "name": "global-toolchain-flag-overrides-config",
      "description": "global toolchain flag overrides config",
      "argv": [
        "run",
        "src/index.cp3",
        "--toolchain",
        "clang"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ],
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "slow": true,
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "hello from hello"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "environment-overrides-config",
      "description": "environment overrides config",
      "argv": [
        "run",
        "src/index.cp3"
      ],
      "env": {
        "CP3_TOOLCHAIN": "clang"
      },
      "setup": {
        "fixtures": [
          "hello"
        ],
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "slow": true,
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "hello from hello"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "verbose-names-source",
      "description": "verbose names source",
      "argv": [
        "run",
        "src/index.cp3",
        "--verbose"
      ],
      "setup": {
        "fixtures": [
          "toolchain-project"
        ]
      },
      "slow": true,
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "toolchain",
            "project"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "cache-invalidated-when-version-changes",
      "description": "cache invalidated when version changes",
      "argv": [
        "build",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "slow": true,
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "files": {
          ".cp3/out/index.exe": {
            "exists": true
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "non-tty-numbered-selection",
      "description": "non tty numbered selection",
      "argv": [
        "toolchain"
      ],
      "stdin": "1\n1\n",
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "Clang",
            "selected"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "non-tty-project-scope",
      "description": "non tty project scope",
      "argv": [
        "toolchain"
      ],
      "stdin": "1\n1\n1\n",
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "selected",
            "this project"
          ]
        },
        "files": {
          "package.json": {
            "contains": [
              "\"toolchain\": {",
              "\"id\": \"clang\""
            ]
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "yes-accepts-default",
      "description": "yes accepts default",
      "argv": [
        "toolchain",
        "--yes"
      ],
      "requires": [
        "command:toolchain",
        "clang",
        "flag:--yes"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": "selected"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "yes-accepts-project-default",
      "description": "yes accepts project default",
      "argv": [
        "toolchain",
        "--yes"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang",
        "flag:--yes"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "selected",
            "this project"
          ]
        },
        "files": {
          "package.json": {
            "contains": [
              "\"toolchain\": {",
              "\"id\": \"clang\""
            ]
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "no-clang-installed",
      "description": "no Clang installed",
      "argv": [
        "toolchain",
        "list"
      ],
      "env": {
        "PATH_MODE": "minimal"
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "clang",
            "missing"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "invalid-toolchain-config",
      "description": "invalid toolchain config falls back",
      "argv": [
        "toolchain",
        "list"
      ],
      "setup": {
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0
      }
    },
    {
      "group": "toolchain",
      "name": "json-list-shape",
      "description": "json list shape",
      "argv": [
        "toolchain",
        "list",
        "--json"
      ],
      "requires": [
        "command:toolchain",
        "clang",
        "flag:--json"
      ],
      "expect": {
        "exit": 0,
        "stdout_json_paths": {
          "ok": true,
          "action": "toolchain-list",
          "current.found": true,
          "current.source": "auto-detect",
          "global.present": false,
          "project.inProject": false,
          "versions.policy": "auto"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "clear-project-pin",
      "description": "clear project pin",
      "argv": [
        "toolchain",
        "clear",
        "--project"
      ],
      "setup": {
        "fixtures": [
          "toolchain-project"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "files": {
          "package.json": {
            "not_contains": "\"toolchain\""
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "clear-global-pin",
      "description": "clear global pin",
      "argv": [
        "toolchain",
        "clear",
        "--global"
      ],
      "setup": {
        "config_fixtures": [
          "toolchain-config"
        ]
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "files": {
          "{config}/toolchain.conf": {
            "absent": true
          }
        }
      }
    },
    {
      "group": "toolchain",
      "name": "detect",
      "description": "detect",
      "argv": [
        "toolchain",
        "detect"
      ],
      "requires": [
