        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "clang"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "use-non-clang-path-rejected",
      "description": "a non-Clang executable path is rejected",
      "argv": [
        "toolchain",
        "use",
        "{repo}/build/bin/cp3c.exe"
      ],
      "requires": [
        "command:toolchain",
        "windows"
      ],
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "not a usable Clang compiler"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "use-non-clang-path-rejected-posix",
      "description": "a non-Clang executable path is rejected on POSIX",
      "argv": [
        "toolchain",
        "use",
        "{repo}/build/bin/cp3c"
      ],
      "requires": [
        "command:toolchain",
        "posix"
      ],
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "not a usable Clang compiler"
        }
      }
    },
    {
      "group": "toolchain",
      "name": "no-project-offers-global-only",
      "description": "no project offers global only",
      "argv": [
        "toolchain",
        "use",
        "clang"
      ],
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "global",
            "no package.json"
          ]
        }
      }
    },
    {
      "group": "toolchain",
      "name": "refuses-unparsable-manifest",
      "description": "refuses unparsable manifest",
      "argv": [
        "toolchain",
        "use",
        "clang",
        "--project"
      ],
      "setup": {
        "files": {
          "package.json": "{ bad json\n"
        }
      },
      "xfail": {
        "id": "manifest-preflight-exit-code",
        "reason": "findPackageScript intercepts every command in a broken project with exit 2 before the toolchain refusal path; expects exit 1 + 'parse'"
      },
      "requires": [
        "command:toolchain",
        "clang"
      ],
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": "parse"
        }
      }
    },
