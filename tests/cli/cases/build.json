    {
      "group": "build",
      "name": "init-package-scaffold-builds",
      "description": "init package scaffold builds",
      "argv": [
        "build",
        "src/index.cp3"
      ],
      "setup": {
        "files": {
          "package.json": "{\n  \"name\": \"pkg\",\n  \"version\": \"1.0.0\",\n  \"description\": \"a C+++ project\",\n  \"type\": \"package\",\n  \"main\": \"src/index.cp3\",\n  \"typeSystem\": \"typescript\",\n  \"scripts\": {\n    \"dev\": \"cp3c dev src/index.cp3\",\n    \"build\": \"cp3c build src/index.cp3\",\n    \"start\": \"cp3c run src/index.cp3\",\n    \"check\": \"cp3c check src/index.cp3\"\n  },\n  \"build\": {\n    \"files\": [\"README.md\"]\n  }\n}\n",
          "src/index.cp3": "// pkg - package entry; every key below is a named export.\nfunction add(a: number, b: number): number {\n  return a + b;\n}\n\nexport default { add };\n"
        }
      },
      "slow": true,
      "xfail": {
        "id": "init-package-object-export",
        "reason": "cp3c init --type package emits export default { add }, which codegen rejects with CP3002"
      },
      "requires": "compiler",
      "expect": {
        "exit": 0,
        "stderr": {
          "not_contains": "CP3002"
        },
        "files": {
          ".cp3/out/pkg.cp3pak": {
            "exists": true
          }
        }
      }
    },
    {
      "group": "build",
      "name": "path-with-spaces",
      "description": "path with spaces",
      "argv": [
        "build",
        "src/index.cp3"
      ],
      "cwd": "build with space",
      "setup": {
        "fixtures": [
          {
            "name": "hello",
            "to": "build with space"
          }
        ]
      },
      "slow": true,
      "xfail": {
        "id": "paths-with-spaces-break-build",
        "reason": "the compiler splits unquoted intermediate paths, so a project directory containing a space fails in g++"
      },
      "requires": "compiler",
      "expect": {
        "exit": 0,
        "files": {
          ".cp3/out/index.exe": {
            "exists": true
          }
        }
      }
    },
