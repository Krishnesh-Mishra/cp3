{
  "group": "dev",
  "cases": [
    {
      "group": "dev",
      "name": "once-hello",
      "description": "once hello",
      "argv": [
        "dev",
        "--once",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "watching src/index.cp3",
            "check ok (exit 0)"
          ]
        }
      }
    },
    {
      "group": "dev",
      "name": "once-default-entry",
      "description": "once default entry",
      "argv": [
        "dev",
        "--once"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "watching",
            "check ok (exit 0)"
          ]
        }
      }
    },
    {
      "group": "dev",
      "name": "once-reports-syntax-error",
      "description": "once reports syntax error",
      "argv": [
        "dev",
        "--once",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "bad-syntax"
        ]
      },
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": [
            "CP3201",
            "check reported problems (exit 1)"
          ]
        }
      }
    },
    {
      "group": "dev",
      "name": "once-reports-type-error",
      "description": "once reports type error",
      "argv": [
        "dev",
        "--once",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "bad-type"
        ]
      },
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": [
            "CP3401",
            "check reported problems (exit 1)"
          ]
        }
      }
    },
    {
      "group": "dev",
      "name": "missing-file",
      "description": "missing file",
      "argv": [
        "dev",
        "--once",
        "missing.cp3"
      ],
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "cannot open 'missing.cp3'"
        }
      }
    },
    {
      "group": "dev",
      "name": "no-file-and-no-default",
      "description": "no file and no default",
      "argv": [
        "dev",
        "--once"
      ],
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "dev needs a .cp3 file to watch"
        }
      }
    },
    {
      "group": "dev",
      "name": "path-with-spaces",
      "description": "path with spaces",
      "argv": [
        "dev",
        "--once",
        "src/index.cp3"
      ],
      "cwd": "dev space",
      "setup": {
        "fixtures": [
          {
            "name": "hello",
            "to": "dev space"
          }
        ]
      },
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": "check ok (exit 0)"
        }
      }
    },
    {
      "group": "dev",
      "name": "verbose-check-output",
      "description": "verbose check output",
      "argv": [
        "dev",
        "--once",
        "--verbose",
        "src/index.cp3"
      ],
      "setup": {
        "fixtures": [
          "hello"
        ]
      },
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": "check ok (exit 0)"
        }
      }
    }
  ]
}
