        }
      }
    },
    {
      "group": "install",
      "name": "hooks-pre-and-post",
      "description": "hooks pre and post",
      "argv": [
        "install"
      ],
      "setup": {
        "fixtures": [
          "hooks"
        ]
      },
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": [
            "running script 'preinstall'",
            "nothing to install",
            "running script 'postinstall'"
          ]
        },
        "files": {
          "hook-order.txt": {
            "equals": "preinstall\npostinstall\n"
          }
        }
      }
    },
    {
      "group": "install",
      "name": "failing-preinstall-aborts",
      "description": "failing preinstall aborts",
      "argv": [
        "install"
      ],
      "setup": {
        "fixtures": [
          "install-project"
        ],
        "files": {
          "package.json": "{\n  \"name\": \"consumer\",\n  \"version\": \"1.0.0\",\n  \"type\": \"application\",\n  \"main\": \"src/index.cp3\",\n  \"scripts\": {\n    \"preinstall\": \"echo pre>>hook.txt && exit 5\"\n  },\n  \"dependencies\": {\n    \"local-kit\": \"file:deps/local-kit\"\n  }\n}\n"
        }
      },
      "expect": {
        "exit": 5,
        "stderr": {
          "contains": [
            "script 'preinstall' failed (exit 5)"
          ]
        },
        "files": {
          "hook.txt": {
            "equals": "pre \n"
          }
        },
        "files_absent": [
          ".cp3/packages/local-kit"
        ]
      }
    },
    {
      "group": "install",
      "name": "malformed-lockfile",
      "description": "malformed lockfile",
      "argv": [
        "install",
        "deps/local-kit"
      ],
      "setup": {
        "fixtures": [
          {
            "name": "install-project"
          },
          {
            "name": "local-dep",
            "to": "deps/local-kit"
          }
        ],
        "files": {
          ".cp3/lock.json": "{ this is not json\n"
        }
      },
      "expect": {
        "exit": 1,
        "stderr": {
          "contains": "lock.json"
        }
      }
    },
    {
      "group": "install",
      "name": "directory-copy-skips-cp3-state",
      "description": "directory copy skips cp3 state",
      "argv": [
        "install",
        "deps/local-kit"
      ],
      "setup": {
        "fixtures": [
          {
            "name": "install-project"
          }
        ],
        "files": {
          "deps/local-kit/package.json": "{\"name\":\"local-kit\",\"version\":\"1.2.3\"}\n",
          "deps/local-kit/src/index.cp3": "export default 1;\n",
          "deps/local-kit/.cp3/out/stale.exe": "stale\n"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": "installed local-kit"
        },
        "files_absent": [
          ".cp3/packages/local-kit/.cp3"
        ]
      }
    },
    {
      "group": "install",
      "name": "auto-flag-with-local-path",
      "description": "auto flag with local path",
      "argv": [
        "install",
        "deps/local-kit",
        "--auto"
      ],
      "setup": {
        "fixtures": [
          {
            "name": "install-project"
          },
          {
            "name": "local-dep",
            "to": "deps/local-kit"
          }
        ]
      },
      "expect": {
        "exit": 0,
        "stderr": {
          "contains": "installed local-kit"
        },
        "files": {
          ".cp3/packages/local-kit/package.json": {
            "exists": true
          }
        }
      }
    },
    {
      "group": "install",
      "name": "rejects-two-sources",
      "description": "rejects two sources",
      "argv": [
        "install",
        "a",
        "b"
      ],
      "expect": {
        "exit": 2,
        "stderr": {
          "contains": "'install' takes at most one path or URL"
        }
      }
    }
  ]
}
