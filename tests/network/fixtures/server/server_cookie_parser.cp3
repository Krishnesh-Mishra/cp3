// cookieParser: fills req.cookies from the Cookie header (raw, unsigned
// parse; no secret configured so signedCookies stays empty).
import console from "std/console";
import { Map } from "std/collections";
import { createServer, fetch, cookieParser } from "std/network";

const app = createServer();
app.use(cookieParser());

app.get("/echo", (req, res) => {
  res.text(req.cookies.get("session") ?? "missing");
});

app.listen(48229, () => {});

let headers = new Map<string, string>();
headers.set("cookie", "session=abc123; other=zzz");
const res = await fetch("http://127.0.0.1:48229/echo", { headers });
console.log(`SC3|${await res.text()}`);

app.close();
