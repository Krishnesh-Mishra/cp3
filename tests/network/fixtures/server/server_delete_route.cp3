// =============================================================================
// tests/network/fixtures/server_delete_route.cp3 - phase B app.delete route.
//
// docs 04 §network: the beta-one verb list is get/post/put/delete. The DELETE
// route answers for DELETE; a GET on the same path falls through to the 404
// fallback. Port 48219 is reserved for this fixture.
// =============================================================================
import console from "std/console";
import { fetch, createServer } from "std/network";

const app = createServer();
app.delete("/items/:id", (req, res) => {
  res.text("deleted");
});
app.listen(48219, () => {});

const res = await fetch("http://127.0.0.1:48219/items/7", { method: "DELETE" });
console.log(`PB4|${res.status}|${await res.text()}`);

const wrongMethod = await fetch("http://127.0.0.1:48219/items/7");
console.log(`PB4b|${wrongMethod.status}|${await wrongMethod.text()}`);
app.close();
