// =============================================================================
// tests/network/fixtures/server_path_eq.cp3 - phase B unannotated field compare.
//
// Regression for finding F3: comparing a req.* field against a string literal
// WITHOUT a type annotation used to lower to a constant-false comma expression
// (`((req).path, std::string("/teapot"), false)`). Codegen now resolves the
// documented `req.method` / `req.path` fields to `string`, so the middleware
// answers with 418 and the fixture prints `PB6|418|teapot`.
// =============================================================================
import console from "std/console";
import { fetch, createServer } from "std/network";

const app = createServer();

app.use((req, res, next) => {
  if (req.path === "/teapot") {   // unannotated: resolves to string
    res.status(418).text("teapot");
    return;
  }
});

const PORT = 48220;
app.listen(PORT, () => {});

let r = await fetch(`http://127.0.0.1:${PORT}/teapot`);
console.log(`PB6|${r.status}|${await r.text()}`);

app.close();
