// =============================================================================
// tests/network/fixtures/server_pending_json_object.cp3 - PENDING SURFACE.
//
// docs 04 §network declares `json<T>(data: T, status?: number): void` for
// HttpResponse, i.e. an explicit type argument WITH a payload. The codegen
// branch for a reified interface T rejects arguments: `CP3002: not implemented
// yet: std/network json<T>() takes no arguments` (networkJsonRecord,
// src/std/network/codegen_methods.cpp). The untyped payload path
// (res.json({...}) / res.json({...}, 201)) plus the reified client read are
// covered by server_json_object.cp3 (B21); the moment this form lowers, the
// fixture prints `PB5p|7|alice` and B19 flips to PASS. Port 48220 is shared
// with server_pending_path_eq.cp3, which is the only one of the two that
// compiles today.
// =============================================================================
import console from "std/console";
import { fetch, createServer } from "std/network";

interface User {
  id: number;
  name: string;
}

const app = createServer();
app.get("/user", (req, res) => {
  res.json<User>({ id: 7, name: "alice" });
});
app.listen(48220, () => {});

const res = await fetch("http://127.0.0.1:48220/user");
const user = await res.json<User>();
console.log(`PB5p|${user.id}|${user.name}`);
app.close();
