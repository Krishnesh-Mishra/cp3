// =============================================================================
// tests/network/fixtures/smoke_health_contract.cp3 - the cp3 fetch checker of
// `--smoke-bench-server` (benchmarks/health-server contract, cp3 entry).
//
// The suite writes a scratch copy of this file with PORT substituted for the
// chosen smoke port (the beta-one std spec has no process-argv surface), then
// runs it against the same-port scratch copy of benchmarks/health-server/cp3.
// Expected stdout is exact and asserted by run_network_suite.py.
// =============================================================================
import console from "std/console";
import { fetch } from "std/network";

const PORT = 48209;
const BASE = `http://127.0.0.1:${PORT}`;

let healthz = await fetch(`${BASE}/healthz`);
console.log(`SM1|${healthz.status}|${await healthz.text()}`);

let root = await fetch(`${BASE}/`);
console.log(`SM2|${root.status}|${await root.text()}`);

let missing = await fetch(`${BASE}/nope`);
console.log(`SM3|${missing.status}|${await missing.text()}`);
