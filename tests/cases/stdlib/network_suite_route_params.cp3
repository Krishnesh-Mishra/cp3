import console from "std/console";
import { fetch, createServer } from "std/network";

// Route params: a `:id` pattern matches and its route answers; a path with an
// extra segment does not match. (Reading the param value through req.params is
// covered by network_suite_params_query_headers.)
const app = createServer();
app.get("/users/:id", (req, res) => {
  res.text("user-route");
});
app.listen(48105, () => {
  console.log("listening");
});

let hit = await fetch("http://127.0.0.1:48105/users/7");
console.log(`${hit.status}`);
console.log(await hit.text());

let miss = await fetch("http://127.0.0.1:48105/users/7/extra");
console.log(`${miss.status}`);
console.log(await miss.text());
app.close();
