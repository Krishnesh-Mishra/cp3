import console from "std/console";
import { Map } from "std/collections";

// A `forEach` callback that is a named function (not an inline arrow): the
// runtime calls it with the value first and the key second (docs 04 Map).
let m = new Map<string, number>();
m.set("a", 1); m.set("b", 2); m.set("c", 3);

let sum = 0;
let keys = "";
function addValue(v: number, k: string) {
  sum = sum + v;
  keys = keys + k;
}
m.forEach(addValue);
console.log(`${sum}`);
console.log(`${keys}`);
