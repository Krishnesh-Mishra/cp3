import console from "std/console";
import fs from "std/fs";
import JSON from "std/json";
interface User { id: number; name: string; }
const path = "__cp3_json_fileapi_async_iface__.json";
fs.writeFileSync(path, "{\"id\":3,\"name\":\"bob\"}");
const u = await JSON.parseFile<User>(path);
console.log(`${u.id} ${u.name}`);
fs.unlinkSync(path);
