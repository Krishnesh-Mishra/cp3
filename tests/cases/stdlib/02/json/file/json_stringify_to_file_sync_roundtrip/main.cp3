import console from "std/console";
import fs from "std/fs";
import JSON from "std/json";
const path = "__cp3_json_fileapi_wroundtrip__.json";
const value = { id: 7, name: "ada", tags: ["x", "y"] };
JSON.stringifyToFileSync(path, value);
console.log(`${JSON.verify<{ id: number, name: string, tags: string[] }>(fs.readFileSync(path))}`);
console.log(fs.readFileSync(path));
const back = JSON.parseFileSync<{ id: number, name: string, tags: string[] }>(path);
console.log(`${back.id} ${back.name} ${back.tags.length}`);
fs.unlinkSync(path);
