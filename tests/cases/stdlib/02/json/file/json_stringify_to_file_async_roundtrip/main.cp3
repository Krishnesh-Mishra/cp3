import console from "std/console";
import fs from "std/fs";
import JSON from "std/json";
const path = "__cp3_json_fileapi_async_wroundtrip__.json";
const value = { id: 1, name: "lovelace", tags: ["a"] };
await JSON.stringifyToFile(path, value);
console.log(`${JSON.verify<{ id: number, name: string, tags: string[] }>(fs.readFileSync(path))}`);
console.log(fs.readFileSync(path));
const back = await JSON.parseFile<{ id: number, name: string, tags: string[] }>(path);
console.log(`${back.id} ${back.name} ${back.tags.length}`);
fs.unlinkSync(path);
