import console from "std/console";
import fs from "std/fs";
import JSON from "std/json";
interface User { id: number; name: string; }
const path = "__cp3_json_fileapi_sync_iface__.json";
fs.writeFileSync(path, "{\"id\":7,\"name\":\"ada\"}");
