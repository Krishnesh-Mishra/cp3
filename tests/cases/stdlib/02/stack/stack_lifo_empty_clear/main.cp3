import console from "std/console";
import { Stack } from "std/collections";

// Empty-stack reads yield undefined; clear empties a non-empty stack.
const s = new Stack<string>();
console.log(s.isEmpty());
console.log(s.pop() === undefined ? "empty" : "not-empty");
s.push("first");
s.push("second");
console.log(`${s.pop()}`);
s.clear();
console.log(s.isEmpty());
console.log(`${s.size}`);
console.log(s.peek() === undefined ? "empty" : "not-empty");
