import console from "std/console";
import { Queue } from "std/collections";

// Empty-queue reads yield undefined; interleaved enqueue/dequeue keeps FIFO.
const q = new Queue<string>();
console.log(q.isEmpty());
console.log(q.dequeue() === undefined ? "empty" : "not-empty");
q.enqueue("first");
q.enqueue("second");
console.log(`${q.dequeue()}`);
q.enqueue("third");
console.log(`${q.dequeue()}`);
console.log(`${q.dequeue()}`);
console.log(q.isEmpty());
console.log(`${q.size}`);
