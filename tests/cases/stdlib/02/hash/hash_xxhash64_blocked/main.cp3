import console from "std/console";
import hash from "std/hash";

// Pinned XXH64 (seed 0) vectors: XXH64("") = 0xEF46DB3751D8E999,
// XXH64("Hello World!") = 0x45AB6734B21E6968. A TypeScript number cannot
// hold these exactly, so check stability and difference here; the exact
// 64-bit values are pinned by the Rust integer_widths-style toString()
// checks alongside.
console.log(hash.xxhash64("") === hash.xxhash64("") ? "xxh64empty" : "bad");
console.log(hash.xxhash64("") !== hash.xxhash64("a") ? "xxh64differs" : "bad");
console.log(hash.xxhash64("hello") === hash.xxhash64("hello") ? "xxh64stable" : "bad");
console.log(hash.xxhash64("hello") !== hash.xxhash64("hellp") ? "xxh64hello" : "bad");
