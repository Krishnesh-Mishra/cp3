import console from "std/console";
import Date from "std/date";

// Deterministic millisecond timestamps (all UTC, all below 2^53 so the
// default number project prints them exactly): epoch, pre-epoch (negative),
// a fractional-millisecond instant, the 2038 boundary and 1900 (both
// outside the signed 32-bit millisecond range).
console.log(`${Date.fromISOString("1970-01-01T00:00:00Z").getTime()}`);
console.log(`${Date.fromISOString("1969-12-31T23:59:59Z").getTime()}`);
console.log(`${Date.fromISOString("2020-01-02T12:00:00.123Z").getTime()}`);
console.log(`${Date.fromISOString("2020-01-02T12:00:00Z").getTime()}`);
console.log(`${Date.fromISOString("2038-01-19T03:14:07Z").getTime()}`);
console.log(`${Date.fromISOString("1900-01-01T00:00:00Z").getTime()}`);
console.log(`${Date.parse("2020-01-02T12:00:00Z")}`);
console.log(`${Date.parse("2021-01-01T00:00:00Z") - Date.parse("2020-01-02T12:00:00Z")}`);
