import console from "std/console";
import { fetch, createServer } from "std/network";

// An empty options object is valid: createServer({}) builds the same
// single-loop server as createServer() with no config applied (no cors,
// no static dir, no body limit, no trust proxy, no custom onError).
const app = createServer({});
app.get("/ping", (req, res) => { res.text("pong"); });
app.listen(48311, () => { console.log("listening"); });

let res = await fetch("http://127.0.0.1:48311/ping");
console.log(`${res.status}`);
console.log(await res.text());
app.close();
