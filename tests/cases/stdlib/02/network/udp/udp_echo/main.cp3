import console from "std/console";
import { createUdpSocket } from "std/network";

// UDP echo roundtrip (deterministic, loopback only). One datagram is sent to
// a bound socket on loopback; it arrives back exactly as sent; the sender
// prints it. Port is ephemeral (0) so concurrent runs cannot collide.
const sock = createUdpSocket("udp4");
sock.on("message", (msg, from) => {
  console.log(msg.toString());
  sock.close();
});
sock.on("listening", () => {
  const port = sock.address().port;
  sock.send("ping", port, "127.0.0.1");
});
sock.bind(0);
