import console from "std/console";
import { WebSocket } from "std/network";

// wss:// against a closed loopback port must surface its failure through the
// "error" event and must never open; the catch arm prints a fixed token.
// (Deterministic, no external host is contacted; the wss handshake to a
// closed port fails at the TCP layer.)
const ws = new WebSocket("wss://127.0.0.1:48246/");
ws.on("open", () => {
  console.log("unexpected-open");
});
ws.on("error", (e) => {
  console.log("Error:wss-connect-refused");
});
