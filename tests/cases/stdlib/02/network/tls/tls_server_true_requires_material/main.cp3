import console from "std/console";
import { createServer } from "std/network";

// createServer({ tls: true }) with no cert/key anywhere must throw at
// construction (fail closed), never start a plaintext server.
try {
  const app = createServer({ tls: true });
  console.log("unexpected-plaintext-server");
} catch (e) {
  console.log("Error:tls-invalid-options");
}
