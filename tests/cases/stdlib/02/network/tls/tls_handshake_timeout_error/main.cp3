import console from "std/console";
import { fetch } from "std/network";

// TLS is ON in v0.2. An https:// fetch to a closed loopback port must fail
// as a rejected Error (connection refused at the TCP layer), never resolve,
// hang, or throw an uncatchable failure. The catch arm prints a fixed
// token; the rejection value's shape is not pinned.
fetch("https://127.0.0.1:48245/", { timeout: 100 }).then((res) => {
  console.log("unexpected-ok");
}).catch((e) => {
  console.log("Error:tls-handshake");
});
