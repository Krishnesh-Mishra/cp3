import console from "std/console";
import { fetch, createServer } from "std/network";

// Concurrent-connection scaling: 10 simultaneous clients (deterministic).
// The harness limit is 10 concurrent connections, NOT 10k: this case
// deliberately stays at the harness ceiling (10 in-flight fetches against
// a 10-thread server) instead of an unrealistic 10k-connection load,
// which would be flaky and exceed the harness budget. All 10 must answer
// with the same body, in issue order.
const app = createServer({ threads: 10 });
app.get("/ping", (req, res) => {
  res.text("ok");
});
app.listen(48243, () => {});

let a = fetch("http://127.0.0.1:48243/ping");
let b = fetch("http://127.0.0.1:48243/ping");
let c = fetch("http://127.0.0.1:48243/ping");
let d = fetch("http://127.0.0.1:48243/ping");
let e = fetch("http://127.0.0.1:48243/ping");
let f = fetch("http://127.0.0.1:48243/ping");
let g = fetch("http://127.0.0.1:48243/ping");
let h = fetch("http://127.0.0.1:48243/ping");
let i = fetch("http://127.0.0.1:48243/ping");
let j = fetch("http://127.0.0.1:48243/ping");
let ra = await a;
let rb = await b;
let rc = await c;
let rd = await d;
let re = await e;
let rf = await f;
let rg = await g;
let rh = await h;
let ri = await i;
let rj = await j;
console.log(await ra.text());
console.log(await rb.text());
console.log(await rc.text());
console.log(await rd.text());
console.log(await re.text());
console.log(await rf.text());
console.log(await rg.text());
console.log(await rh.text());
console.log(await ri.text());
console.log(await rj.text());
app.close();
