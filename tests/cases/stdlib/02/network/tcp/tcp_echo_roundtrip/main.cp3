import console from "std/console";
import { createTcpServer, connectTcp } from "std/network";

// TCP echo roundtrip (deterministic, loopback only). One client sends one
// payload; the server echoes it verbatim with the "echo:" prefix; the
// client prints exactly what came back.
const server = createTcpServer();
server.on("connection", (socket) => {
  socket.on("data", (chunk) => {
    socket.write("echo:" + chunk);
  });
});
server.listen(48241);

const client = connectTcp("127.0.0.1", 48241);
client.on("connect", () => {
  client.write("ping");
});
client.on("data", (chunk) => {
  console.log(chunk);
  client.close();
  server.close();
});
