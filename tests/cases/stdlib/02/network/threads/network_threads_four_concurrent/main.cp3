import console from "std/console";
import { fetch, createServer } from "std/network";

const app = createServer({ threads: 4 });
app.get("/ping", (req, res) => {
  res.text("ok");
});
app.listen(48119, () => {
  console.log("listening");
});

let a = fetch("http://127.0.0.1:48119/ping");
let b = fetch("http://127.0.0.1:48119/ping");
let c = fetch("http://127.0.0.1:48119/ping");
let d = fetch("http://127.0.0.1:48119/ping");
let ra = await a;
let rb = await b;
let rc = await c;
let rd = await d;
console.log(await ra.text());
console.log(await rb.text());
console.log(await rc.text());
console.log(await rd.text());
app.close();
