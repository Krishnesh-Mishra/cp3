import console from "std/console";
import { fetch, createServer } from "std/network";

let hits = 0;

// Module-level state must survive across requests within one server process.
// `threads: 1` so the kernel's SO_REUSEPORT hashing cannot route the two
// requests to different workers (the counter is per-process by design).
const app = createServer({ threads: 1 });
app.get("/hit", (req, res) => {
  hits = hits + 1;
  res.json(hits);
});
app.listen(48120, () => {
  console.log("listening");
});

let first = await fetch("http://127.0.0.1:48120/hit");
console.log(await first.text());
let second = await fetch("http://127.0.0.1:48120/hit");
console.log(await second.text());
app.close();
