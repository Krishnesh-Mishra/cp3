import console from "std/console";
import { fetch, createServer } from "std/network";

// Request bodies: `await req.text()` buffers the POST body and the handler
// echoes it back (docs: HttpRequest.text() -> Promise<string>). Async route
// handlers are supported: the runtime buffers the body before dispatch and the
// handler awaits it. This case is the regression gate for that surface.
const app = createServer();

app.post("/echo", async (req, res) => {
  res.text(await req.text());
});
app.listen(48112, () => {
  console.log("listening");
});

let echoed = await fetch("http://127.0.0.1:48112/echo", {
  method: "POST",
  body: "payload",
});
console.log(`${echoed.status}`);
console.log(await echoed.text());
app.close();
