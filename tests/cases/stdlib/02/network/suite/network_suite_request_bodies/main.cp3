import console from "std/console";
import { fetch, createServer } from "std/network";

// Request bodies: `await req.text()` buffers the POST body and the handler
// echoes it back (docs: HttpRequest.text() -> Promise<string>).
//
// PENDING SURFACE: the await needs an async handler, and the async arrow
// lowering is still a codegen seam (`CP3002: not implemented yet: async arrow
// function`); the runtime buffers the body before dispatch, but no handler
// form can await it yet. This case is the landing gate for that surface: it
// stays docs-faithful, not weakened.
const app = createServer();

app.post("/echo", async (req, res) => {
  res.text(await req.text());
});
app.listen(48112, () => {
  console.log("listening");
});

let echoed = await fetch("http://127.0.0.1:48112/echo", {
  method: "POST",
  body: "payload",
});
console.log(`${echoed.status}`);
console.log(await echoed.text());
app.close();
