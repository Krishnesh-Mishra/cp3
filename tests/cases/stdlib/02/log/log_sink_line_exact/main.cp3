import { Logger } from "std/log";
import console from "std/console";

// A sink receives the exact line (no trailing newline) including rendered
// extra args, and filtered-out levels deliver nothing to the sink.
const log = new Logger("app");
const lines: string[] = [];
log.setSink((line: string) => { lines.push(line); });
log.debug("hidden");
log.info("msg", 1, "x");
console.log(lines.length === 1 && lines[0] === "INFO app msg 1 x" ? "ok" : "bad");
