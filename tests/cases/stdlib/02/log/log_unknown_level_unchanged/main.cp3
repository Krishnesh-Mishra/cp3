import { Logger } from "std/log";
import console from "std/console";

// An unknown level name leaves the level unchanged; level names are
// case-insensitive when set.
const log = new Logger("app");
console.log(log.level);
log.setLevel("bogus");
console.log(log.level);
log.debug("hidden");
log.setLevel("WARN");
console.log(log.level);
log.info("hidden too");
log.error("shown");
