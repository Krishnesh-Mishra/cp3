import { Logger } from "std/log";
import console from "std/console";
const log = new Logger("svc");
const lines: string[] = [];
log.setSink((line: string) => { lines.push(line); });
log.debug("hidden too");
log.setLevel("debug");
log.debug("d");
log.info("i");
for (const l of lines) {
  console.log(l);
}
