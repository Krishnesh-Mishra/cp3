import console from "std/console";
import { fetch, createServer } from "std/network";

const app = createServer();
app.get("/", (req, res) => {
  res.text("home");
});
app.listen(48102, () => {});

let res = await fetch("http://127.0.0.1:48102/missing");
console.log(`${res.status} ${res.ok}`);
console.log(await res.text());
app.close();
