import console from "std/console";
import crypto from "std/crypto";
let encrypted = crypto.AES256("somekey", "secret");
let tampered = encrypted.slice(0, 10) +
    (encrypted.charAt(10) === "A" ? "B" : "A") + encrypted.slice(11);
try {
    crypto.AES256Decrypt("somekey", tampered);
    console.log("no");
} catch (e) {
    console.log("bad");
}
