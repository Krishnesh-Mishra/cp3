import console from "std/console";

// The event name may be any string expression: the runtime keeps the
// listeners of the events it knows and ignores the others.
const event: string = "line";

// The registration is compiled but never run (a live listener would wait for
// stdin); the call itself must lower.
function register(): undefined {
    console.on(event, (line) => console.log("line:", line));
    console.off(event, (line) => console.log("line:", line));
}

console.log("ok");
