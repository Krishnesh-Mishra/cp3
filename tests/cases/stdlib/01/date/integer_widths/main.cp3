import console from "std/console";
import Date from "std/date";

// A Rust project sees exact Date timestamps: milliseconds since the epoch
// are i64 end to end.
const parsed: i64 = Date.parse("2020-01-02T12:00:00Z");
const created = Date.fromISOString("2020-01-02T12:00:00Z");
let d = created;
const ms: i64 = d.getTime();
console.log(parsed === ms ? "parse" : "bad");

const later = d.addSeconds(2);
const diff: i64 = later.diffMs(d);
console.log(diff === 2000 ? "diff" : "bad");

const set = d.setTime(parsed + 2000);
console.log(set === parsed + 2000 ? "settime" : "bad");

const moved = d.setFullYear(2021);
console.log(moved > set ? "setyear" : "bad");
