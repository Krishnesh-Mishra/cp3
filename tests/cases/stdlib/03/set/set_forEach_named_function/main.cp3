import console from "std/console";
import { Set } from "std/collections";

// A `forEach` callback that is a named function (not an inline arrow): the
// runtime calls it with the value (docs 04 Set).
let s = new Set<number>();
s.add(1); s.add(2); s.add(3);

let sum = 0;
function addValue(v: number) {
  sum = sum + v;
}
s.forEach(addValue);
console.log(`${sum}`);
