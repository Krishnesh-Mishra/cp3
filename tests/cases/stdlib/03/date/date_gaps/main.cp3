import console from "std/console";
const d = new Date(0);
console.log(`${d.getTime}`);
console.log(`${d.getDay}`);
console.log(`${d.getUTCFullYear}/${d.getUTCMonth + 1}/${d.getUTCDate}`);
let e = Date.fromISOString("2024-01-15T12:30:00.000Z");
e.setHours(8);
console.log(`${e.getHours}`);
e.setFullYear(2025);
console.log(`${e.getFullYear}`);
console.log(`${Date.parse("2024-01-15T12:30:00.000Z")}`);
