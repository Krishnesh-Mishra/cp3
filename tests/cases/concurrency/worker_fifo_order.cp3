import console from "std/console";

const w = new Worker("./worker_echo_impl.cp3");
w.postMessage(1);
w.postMessage(2);
w.postMessage(3);
w.postMessage(4);
w.postMessage(5);
let seen = 0;
w.on("message", (msg) => {
  console.log(`${msg}`);
  seen = seen + 1;
  if (seen == 5) {
    w.terminate();
  }
});
