import console from "std/console";

interface Box<T> { value: T; get(): T; }

class NumBox {
  value: number = 1;
  function get(): number { return this.value; }
}

class StrBox {
  value: string = "s";
  function get(): string { return this.value; }
}

let a: Box<number> = new NumBox();
let b: Box<string> = new StrBox();
console.log(a.value);
console.log(a.get());
console.log(b.value);
console.log(b.get());
