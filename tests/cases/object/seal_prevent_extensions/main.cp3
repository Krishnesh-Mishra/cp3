import console from "std/console";

const o: { x: number } = { x: 1 };
console.log(`${Object.isSealed(Object.seal(o))}`);
console.log(`${Object.isFrozen(Object.seal(o))}`);
console.log(`${Object.isExtensible(Object.seal(o))}`);
console.log(`${Object.is(Object.seal(o), o)}`);
console.log(`${Object.isExtensible(Object.preventExtensions(o))}`);
console.log(`${Object.isSealed(Object.preventExtensions(o))}`);
console.log(`${Object.isFrozen(Object.preventExtensions(o))}`);
console.log(`${Object.is(Object.preventExtensions(o), o)}`);
