import console from "std/console";
class Node {
  value: number;
  next: Node | null;
  constructor(value: number, next: Node | null) {
    this.value = value;
    this.next = next;
  }
}
const head = new Node(1, new Node(2, null));
let items: Node[] = [];
items.push(head);
let cur: Node | null = items[0];
while (cur !== null && cur.next !== null) {
  console.log(`${cur.next.value}`);
  cur = cur.next;
}
console.log("array-store-ok");
