import console from "std/console";
class Node {
  value: number;
  next: Node | null;
  constructor(value: number, next: Node | null) {
    this.value = value;
    this.next = next;
  }
}
const head = new Node(1, new Node(2, new Node(3, null)));
let cur: Node | null = head;
while (cur !== null && cur.next !== null) {
  console.log(`${cur.value}`);
  cur = cur.next;
}
if (cur !== null) {
  console.log(`${cur.value}`);
}
