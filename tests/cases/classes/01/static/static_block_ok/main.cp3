import console from "std/console";

class Counter {
  static value: number = 1;
  static #hidden: number = 3;

  static {
    Counter.value = Counter.value + 1;
    Counter.#hidden = Counter.#hidden + 1;
  }

  static hidden(): number {
    return Counter.#hidden;
  }
}

console.log(Counter.value.toFixed(0));
console.log(Counter.hidden().toFixed(0));
