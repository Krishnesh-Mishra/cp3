import console from "std/console";
class Animal { name(): string { return "animal"; } }
class Dog extends Animal { bark(): string { return "woof"; } }
const items: Animal[] = [new Dog(), new Animal(), new Dog()];
let d: number = 0;
for (const it of items) { if (it instanceof Dog) { d += 1; } }
console.log(`${d}`);
