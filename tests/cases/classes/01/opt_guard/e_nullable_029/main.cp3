import console from "std/console";
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) { this.x = x; this.y = y; }
}
const n: (Point | null) = new Point(3, 4);
if (n !== null) { console.log(`${n.x} ${n.y}`); }
const m: (Point | null) = null;
if (m !== null) { console.log("set"); } else { console.log("null"); }
