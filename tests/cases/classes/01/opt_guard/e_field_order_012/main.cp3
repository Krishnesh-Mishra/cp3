import console from "std/console";
class Bag {
  a: number;
  b: number;
  c: number;
  d: number;
  e: number;
  f: number;
  constructor() { this.a = 1; this.b = 2; this.c = 3; this.d = 4; this.e = 5; this.f = 6; }
  sum(): number { return this.a + this.b + this.c + this.d + this.e + this.f; }
}
console.log(`${new Bag().sum()}`);
