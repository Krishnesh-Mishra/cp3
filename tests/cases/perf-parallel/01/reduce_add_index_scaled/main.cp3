// Scaled integer expressions on the right of `+`.
import console from "std/console";

const doubled = parallel.reduce(1..101, 0, (acc, i) => acc + i * 2);
const affine = parallel.reduce(0..10, 0, (acc, i) => acc + (i * 3 + 1));
const pair = parallel.reduce(0..10, 0, (acc, i) => acc + (i + 1) * (i + 2));

console.log(`${doubled} ${affine} ${pair}`);
