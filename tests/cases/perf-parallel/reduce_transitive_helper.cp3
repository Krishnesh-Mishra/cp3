// Purity is transitive: outer calls base, and both are pure integer helpers.
import console from "std/console";

function base(i: number): number {
  return i * 2;
}

function outer(i: number): number {
  return base(i) + 1;
}

const total = parallel.reduce(1..101, 0, (acc, i) => acc + outer(i));
console.log(`${total}`);
