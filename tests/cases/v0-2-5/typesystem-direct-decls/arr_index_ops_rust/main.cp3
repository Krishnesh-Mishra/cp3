import console from "std/console";

// findIndex returns -1 on miss, so a signed index in a Rust project.
const arr = [9, 3, 7, 1, 8];
const found: i64 = arr.findIndex((x) => x > 6);
const missing: i64 = arr.findIndex((x) => x > 100);
console.log(`${found} ${missing}`);

const sorted = [1, 3, 7, 9];
const bin: i64 = sorted.binarySearch(7);
const missIdx: i64 = sorted.findIndex((x) => x === 7);
console.log(`${bin} ${missIdx}`);
