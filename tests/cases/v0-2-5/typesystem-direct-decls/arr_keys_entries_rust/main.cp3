import console from "std/console";

// The index slots `arr.keys()` produces are `usize` in a Rust project; the
// binding in a `for..of` takes that exact type.
const arr = [10, 20, 30];
let count = 0;
for (const k of arr.keys()) {
    const exact: usize = k;
    if (exact >= 0) count += 1;
}
console.log(`${count}`);
