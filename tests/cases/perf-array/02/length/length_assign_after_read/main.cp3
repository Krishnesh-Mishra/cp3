import console from "std/console";
const words: string[] = ["alpha", "bravo"];
{
  const word = words[0];
  words.length = 0;
  console.log(word);
}
// An array's length is read-only in cp3 today (assigning to it has no C++
// write form), so `cp3 check` reports CP3204 (invalid assignment target).
// Pinned as the current, deliberate diagnostic; revisit when a length write
// form lands.
