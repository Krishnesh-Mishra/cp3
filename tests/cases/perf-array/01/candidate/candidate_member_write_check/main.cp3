import console from "std/console";
const words: string[] = ["alpha", "bravo"];
{
  const word = words[0];
  word.length = 0;
  console.log(word);
}
// A string's length is read-only: the write has no C++ write form, so
// `cp3 check` reports CP3204 (invalid assignment target). Pinned as the
// current, deliberate diagnostic; revisit when a length write form lands.
