import console from "std/console";
import { Map } from "std/collections";
class Holder {
    items: Map<string, number> = new Map<string, number>();
}
const h = new Holder();
h.items.set("z", 9);
h.items.set("y", 8);
console.log(h.items.size);
const z = h.items.get("z");
if (z !== undefined) {
    console.log(z);
}
