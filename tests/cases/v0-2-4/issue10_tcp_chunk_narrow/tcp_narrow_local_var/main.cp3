import console from "std/console";
import { createTcpServer, connectTcp } from "std/network";
const server = createTcpServer();
server.on("connection", (socket) => {
  socket.on("data", (chunk) => {
    const len = typeof chunk === "string" ? chunk.length : 0;
    socket.write(`v:${len}`);
  });
});
server.listen(48254);
const client = connectTcp("127.0.0.1", 48254);
client.on("connect", () => {
  client.write("ping");
});
client.on("data", (chunk) => {
  console.log(chunk);
  client.close();
  server.close();
});
