import console from "std/console";
import { createTcpServer, connectTcp } from "std/network";
const server = createTcpServer();
function buildTail(s: string): string {
  return s + "!";
}
server.on("connection", (socket) => {
  socket.on("data", (chunk) => {
    if (typeof chunk === "string") {
      socket.write(buildTail(chunk));
    } else {
      socket.write("not-string");
    }
  });
});
server.listen(48253);
const client = connectTcp("127.0.0.1", 48253);
client.on("connect", () => {
  client.write("ping");
});
client.on("data", (chunk) => {
  console.log(chunk);
  client.close();
  server.close();
});
