import console from "std/console";
import { createTcpServer, connectTcp } from "std/network";
const server = createTcpServer();
server.on("connection", (socket) => {
  socket.on("data", (chunk) => {
    const k = typeof chunk === "string" ? "yes" : "no";
    socket.write(`match:${k}`);
  });
});
server.listen(48257);
const client = connectTcp("127.0.0.1", 48257);
client.on("connect", () => {
  client.write("ping");
});
client.on("data", (chunk) => {
  console.log(chunk);
  client.close();
  server.close();
});
