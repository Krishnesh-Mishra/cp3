import console from "std/console";
import { createTcpServer, connectTcp } from "std/network";
const server = createTcpServer();
server.on("connection", (socket) => {
  socket.on("data", (chunk) => {
    console.log(`s:${typeof chunk === "string"}`);
    socket.write("echo:ping");
  });
});
server.listen(48250);
const client = connectTcp("127.0.0.1", 48250);
client.on("connect", () => {
  client.write("ping");
});
client.on("data", (chunk) => {
  console.log(chunk);
  client.close();
  server.close();
});
