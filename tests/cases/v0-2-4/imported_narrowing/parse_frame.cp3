import console from "std/console";
import { Frame } from "./frame.cp3";

function read(): Frame | undefined {
  const f = parseFrame(undefined);
  if (f === undefined) return undefined;
  return parseFrame(f);
}

interface Msg { id: number }

function parseFrame(x: Frame | undefined): Frame | undefined {
  return x;
}

console.log(typeof read());
