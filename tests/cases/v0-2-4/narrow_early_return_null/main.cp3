import console from "std/console";
class Node {
    value: number;
    next: Node | null;
    constructor(value: number, next: Node | null) {
        this.value = value;
        this.next = next;
    }
}
const head = new Node(1, new Node(2, null));
const valueOf = (n: Node | null): number => {
    if (n === null) {
        return 0;
    }
    return n.value;
};
console.log(valueOf(head.next));
console.log(valueOf(null));
