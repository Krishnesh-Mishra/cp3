import console from "std/console";
import { Map } from "std/collections";
class Holder {
    items: Map<string, number>;
    constructor() {
        this.items = new Map<string, number>();
        this.items.set("k", 11);
    }
}
const h: Holder | undefined = new Holder();
if (typeof h === "object") {
    console.log(h.items.get("k"));
}
