import console from "std/console";
import { Map } from "std/collections";

// Oracle: each i in 0,1,2 is missed once and inserted with count 1, in first
// insertion order: keys 0,1,2; values 1,1,1; size 3.
{
  const m = new Map<number, number>();
  let i = 0;
  while (i < 3) {
    const v = m.get(i) ?? 0;
    m.set(i, v + 1);
    i = i + 1;
  }
  console.log(m.keys().join(","));
  console.log(m.values().join(","));
  console.log(`${m.size}`);
}
