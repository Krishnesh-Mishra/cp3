// A fused update on a miss after a delete must probe the hash index as empty
// and append the re-added key at the end, not resurrect the deleted slot or
// reuse its old position. Oracle: keys b,a with values 2,42.
import console from "std/console";
import { Map } from "std/collections";

{
  const m = new Map<string, number>();
  m.set("a", 1);
  m.set("b", 2);
  m.delete("a");
  const v = m.get("a") ?? 41;
  m.set("a", v + 1);
  console.log(m.keys().join(","));
  console.log(m.values().join(","));
  console.log(`${m.size}`);
}
