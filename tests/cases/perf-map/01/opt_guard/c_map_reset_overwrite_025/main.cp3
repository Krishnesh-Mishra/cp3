import console from "std/console";
import { Map } from "std/collections";

// Oracle: re-setting an existing key replaces the value without growing
// the map.
const m = new Map<string, number>();
m.set("a", 1);
m.set("b", 2);
m.set("c", 3);
m.set("b", 20);
console.log(`${m.get("b")}`);
console.log(`${m.size}`);
