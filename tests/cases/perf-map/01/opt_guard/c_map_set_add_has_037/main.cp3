import console from "std/console";
import { Set } from "std/collections";

// Oracle: add is idempotent for existing keys; has flips yes/no/no;
// size is 2.
const s = new Set<string>();
s.add("red");
s.add("green");
s.add("red");
console.log(s.has("red") ? "yes" : "no");
console.log(s.has("blue") ? "yes" : "no");
console.log(`${s.size}`);
