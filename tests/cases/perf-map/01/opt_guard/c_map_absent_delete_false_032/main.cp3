import console from "std/console";
import { Map } from "std/collections";

// Oracle: deleting an absent key reports false and leaves the order
// untouched.
const m = new Map<string, number>();
m.set("a", 1);
m.set("b", 2);
m.set("c", 3);
console.log(m.delete("zz") ? "yes" : "no");
console.log(m.keys().join(","));
