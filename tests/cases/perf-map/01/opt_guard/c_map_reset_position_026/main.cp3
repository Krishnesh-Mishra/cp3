import console from "std/console";
import { Map } from "std/collections";

// Oracle: re-setting existing keys keeps their original positions; only
// the values change: keys a,b,c values 10,2,30.
const m = new Map<string, number>();
m.set("a", 1);
m.set("b", 2);
m.set("c", 3);
m.set("a", 10);
m.set("c", 30);
console.log(m.keys().join(","));
console.log(m.values().join(","));
