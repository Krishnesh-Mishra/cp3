import console from "std/console";

// Oracle: groupBy on first letter: a group is apple,avocado; b group is
// banana,berry; two groups.
const words = ["apple", "avocado", "banana", "berry"];
let g: Record<string, string[]> = Object.groupBy(words, (w) => w.charAt(0));
console.log(g.get("a").join(","));
console.log(g.get("b").join(","));
console.log(`${g.size}`);
