import console from "std/console";
import { Map } from "std/collections";

// Oracle: forEach visits exactly size entries; the count is 3.
const m = new Map<string, number>();
m.set("a", 1);
m.set("b", 2);
m.set("c", 3);
let count = 0;
m.forEach((v, k) => { count = count + 1; });
console.log(`${count}`);
