import console from "std/console";
import { Map } from "std/collections";

// Oracle: forEach can rebuild the key list in insertion order: a,b,c.
const m = new Map<string, number>();
m.set("a", 1);
m.set("b", 2);
m.set("c", 3);
let acc = "";
m.forEach((v, k) => { acc = acc === "" ? k : acc + "," + k; });
console.log(acc);
