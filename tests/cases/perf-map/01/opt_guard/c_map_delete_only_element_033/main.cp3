import console from "std/console";
import { Map } from "std/collections";

// Oracle: deleting the only key empties the map; re-adding it restores it.
const m = new Map<string, number>();
m.set("solo", 7);
console.log(m.delete("solo") ? "yes" : "no");
console.log(`${m.size}`);
m.set("solo", 9);
console.log(m.keys().join(","));
