import console from "std/console";

// Oracle: groupBy on first letter: a group keeps list order
// ant,ape,armadillo; b group is bee,bat; two groups.
const words = ["ant", "ape", "armadillo", "bee", "bat"];
let g: Record<string, string[]> = Object.groupBy(words, (w) => w.charAt(0));
console.log(g.get("a").join(","));
console.log(g.get("b").join(","));
console.log(`${g.size}`);
