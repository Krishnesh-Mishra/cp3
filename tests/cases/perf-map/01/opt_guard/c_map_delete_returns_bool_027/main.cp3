import console from "std/console";
import { Map } from "std/collections";

// Oracle: delete on a present key returns true, on an absent key false.
const m = new Map<string, number>();
m.set("a", 1);
m.set("b", 2);
console.log(m.delete("a") ? "yes" : "no");
console.log(m.delete("zz") ? "yes" : "no");
