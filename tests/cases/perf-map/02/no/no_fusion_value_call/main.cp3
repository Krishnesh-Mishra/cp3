import console from "std/console";
import { Map } from "std/collections";

// Oracle: the value calls bump once, so x = 10 + 1 = 11 and calls is 1.
// A call in the value must block fusion.
let calls = 0;
function bump(v: number): number {
  calls = calls + 1;
  return v + 1;
}

{
  const m = new Map<string, number>();
  m.set("x", 10);
  const v = m.get("x") ?? 0;
  m.set("x", bump(v));
  console.log(`${calls}`);
  console.log(`${m.get("x")}`);
}
