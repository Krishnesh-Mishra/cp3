import console from "std/console";
const a = [1, 2, 3, 4];
console.log(a.toSpliced(1, 2, 9).join(","));
console.log(a.join(","));
console.log(a.with(0, 99).join(","));
console.log(a.with(-1, 7).join(","));
const b = [1, 2, 3, 4, 5];
b.copyWithin(1, 3);
console.log(b.join(","));
const c = [1, 2, 3, 4, 5];
c.copyWithin(0, 3, 5);
console.log(c.join(","));
const deep = [[[1], [2]], [[3]]];
console.log(deep.flat(2).join(","));
console.log(deep.flat().length);
console.log([9].flat(0).join(","));
