import console from "std/console";

// A continue in a nested for belongs to the for. The outer counter must still
// produce the unfused result.
// Oracle: each outer iteration adds 2, so total = 8 and c = 4.
let c = 0;
let total = 0;
while (c < 4) {
  for (let i = 0; i < 3; i = i + 1) {
    if (i === 1) {
      continue;
    }
    total = total + 1;
  }
  c = c + 1;
}
console.log(c);
console.log(total);
