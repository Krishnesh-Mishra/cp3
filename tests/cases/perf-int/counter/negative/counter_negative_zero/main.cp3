import console from "std/console";

// The R1 counter cannot preserve the sign of a negative-zero start, and the
// loop never runs, so the sign is observable afterwards.
// Oracle: the loop does not run and 1 / -0 is -Infinity.
let x = -0;
while (x < 0) {
  console.log(x);
  x = x + 1;
}
console.log(1 / x);
