import console from "std/console";

// The loop bound N is a module const shadowed by a block local. The rewrite
// must use the block value, or reject.
// Oracle: c = 10, s = 0 + 1 + ... + 9 = 45.
const N = 3;
let c = 0;
let s = 0;
{
  let N = 10;
  while (c < N) {
    s = s + c;
    c = c + 1;
  }
}
console.log(c);
console.log(s);
