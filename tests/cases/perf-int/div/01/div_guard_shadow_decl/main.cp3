import console from "std/console";

// A declaration inside the then-branch binds a new x. The outer fact is about
// the parameter, not the shadow, so the division must be checked.
// Oracle: the inner x is 6 and 6 / 4 = 1.5.
function f(x: number): number {
  if (x % 4 === 0) {
    let x = 6;
    return x / 4;
  }
  return 0;
}

console.log(f(8));
