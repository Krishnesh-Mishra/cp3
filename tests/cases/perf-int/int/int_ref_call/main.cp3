import console from "std/console";

// A call with a `ref` argument mutates the local through shared storage, and
// the int64 fast body cannot bind an int64 local to a double reference.
// Oracle: x becomes 5, 5 / 4 = 1.25.
function bump(ref x: number): undefined {
  x = 5;
}

function f(): number {
  let x = 8;
  if (x % 4 === 0) {
    bump(x);
    return x / 4;
  }
  return x;
}
console.log(f());
