import console from "std/console";

// WS1.3: a module binding read by a top-level arrow (an array callback) must
// still work when the binding is a `main` local. Oracle: 11 + 12 + 13 = 36.
let base = 10;
let nums = [1, 2, 3];
let out = nums.map((n: number): number => n + base);
console.log(out[0] + out[1] + out[2]);
