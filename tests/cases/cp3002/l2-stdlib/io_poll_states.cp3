import io from "std/io";
import console from "std/console";

console.log(`${io.POLL_DONE},${io.POLL_READING},${io.POLL_WRITING},${io.POLL_FAILED}`);
await io.pollUntilDone(() => -1, () => io.POLL_DONE);
console.log("done");
try {
  await io.pollUntilDone(() => -1, () => io.POLL_FAILED);
  console.log("bad");
} catch (err) {
  console.log("failed:" + err.message);
}
try {
  await io.pollUntilDone(() => -1, () => 99);
  console.log("bad");
} catch (err) {
  console.log("unknown:" + err.message);
}
