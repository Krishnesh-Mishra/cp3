import console from "std/console";
import { fetch, createServer } from "std/network";

// An async handler with no suspension point returns an already-settled
// promise; the dispatcher must continue the chain exactly like a sync handler.
const app = createServer();
app.get("/inline", async (req, res) => {
  res.text("inline");
});
app.listen(48231, () => {
  console.log("listening");
});

const res = await fetch("http://127.0.0.1:48231/inline");
console.log(`${res.status}`);
console.log(await res.text());
app.close();
