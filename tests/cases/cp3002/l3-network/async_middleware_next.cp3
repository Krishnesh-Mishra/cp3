import console from "std/console";
import { fetch, createServer } from "std/network";

// An async middleware may await before it calls next(); the chain continues
// from the next route and the runtime does not answer 404 early.
const app = createServer();
app.use(async (req, res, next) => {
  await Promise.resolve(0);
  next();
});
app.get("/ok", (req, res) => {
  res.text("ok");
});
app.listen(48232, () => {
  console.log("listening");
});

const res = await fetch("http://127.0.0.1:48232/ok");
console.log(`${res.status}`);
console.log(await res.text());
app.close();
