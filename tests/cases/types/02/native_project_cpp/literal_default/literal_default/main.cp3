import console from "std/console";

// Un-annotated literal bindings take the C++ `int` default (canonical id
// i32), escalating to i64 then u64 when the literal does not fit;
// fractional spellings keep `number` (cp3's double).
const small = 8080;
const big = 9007199254740992;
const huge = 18446744073709551615;
const negative = -5;
const floaty = 2.5;

console.log(`${small} ${big} ${huge} ${negative} ${floaty}`);
