import console from "std/console";

let a: r_'i64' = 9007199254740992;
a += 1;
let b: r_'i64' = a + 1;
let c: r_'i64' = a * 2;
let d: r_'u64' = 0;
// Native integer arithmetic is checked in every mode: underflow throws
// instead of wrapping (`d.wrappingMul` is the explicit opt-in).
try {
  d -= 1;
  console.log("no-throw");
} catch (e) {
  console.log(`${d}`);
}

console.log(`${a} ${b} ${c} ${d}`);
