import console from "std/console";

// On an empty array `length - 1` is -1 (a number), not an unsigned wrap.
// `length` is a usize in a rust project, so the native->number conversion
// is explicit via parseTo.
let empty: i64[] = [];
let none: number = parseTo(empty.length, number) - 1;
console.log(`${none} ${none < 0}`);

// The same expression drives the usual "last element" loop guard without
// indexing the array.
let seen: number = 0;
for (let i: number = 0; i <= parseTo(empty.length, number) - 1; i++) {
  seen += 1;
}
console.log(`${seen}`);
