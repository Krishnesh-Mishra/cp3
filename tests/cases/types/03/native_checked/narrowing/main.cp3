import console from "std/console";

// A narrowing conversion of a runtime value is explicit and checked: it throws
// instead of truncating.
let big: number = 70000;
try {
  let x: u16 = big as u16;
  console.log("as:no");
} catch (e) {
  console.log("as:" + e.message);
}

try {
  let x: u16 = parseTo<u16>(big);
  console.log("parseTo:no");
} catch (e) {
  console.log("parseTo:" + e.message);
}

let fraction: number = 1.5;
try {
  let x: i32 = fraction as i32;
  console.log("fraction:no");
} catch (e) {
  console.log("fraction:" + e.message);
}

// Widening is lossless and stays implicit; narrowing back to `number` from a
// 64-bit value is the one explicit precision-losing direction.
let small: i32 = 42;
let wide: i64 = small as i64;
let back: number = wide as number;
console.log(`${small} ${wide} ${back}`);
