import console from "std/console";

function sum(values: i64[]): i64 {
  let total: i64 = 0;
  let i: u32 = 0;
  while (i < values.length) {
    total += values[i];
    i += 1;
  }
  return total;
}

let a: i64 = 10;
let b: u32 = 3;
let wide: i64 = a * b + 1;
let shr: i64 = wide >> 1;
let mask: u32 = 0b1010_1010;
let low: u32 = mask & 0x0F;
let opt: i64 | undefined = wide;
let xs: i64[] = [1, 2, 3];
let u: usize = 4;
let s: isize = -2;
let f: f64 = 1.5;
let ok: bool = true;

console.log(`${wide} ${shr} ${low} ${sum(xs)} ${opt} ${u} ${s} ${f} ${ok}`);
console.log(typeof wide, typeof f, typeof ok);
