import console from "std/console";
class Node {
  value: number;
  next: Node | null;
  constructor(value: number, next: Node | null) {
    this.value = value;
    this.next = next;
  }
}
const a = new Node(1, new Node(2, null));
let cur: Node | null = a;
while (cur !== null && cur.next !== null) {
  console.log(`${cur.next.value}`);
  cur = cur.next;
}
console.log(`${cur!.value}`);
