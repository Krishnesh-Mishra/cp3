import console from "std/console";
class BST {
  value: number;
  left: BST | null;
  right: BST | null;
  constructor(value: number, left: BST | null, right: BST | null) {
    this.value = value;
    this.left = left;
    this.right = right;
  }
}
function search(node: BST | null, target: number): BST | null {
  if (node === null) {
    return null;
  }
  if (target === node.value) {
    return node;
  }
  if (target < node.value) {
    return search(node.left, target);
  }
  return search(node.right, target);
}
const root = new BST(
  10,
  new BST(5, null, new BST(7, null, null)),
  new BST(15, null, null),
);
const found = search(root, 7);
if (found !== null) {
  console.log(`${found.value}`);
}
const missing = search(root, 99);
console.log(missing === null);
